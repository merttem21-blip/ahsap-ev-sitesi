---
// /projeler: projesi olan tüm kategoriler kart olarak listelenir; kartlar kategori sayfalarına gider.
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Kart from '../components/Kart.astro';
import { kategoriler } from '../data/site';
import { gorsel } from '../lib/gorsel';
import { fotoYolu, kapakFotosu, kategoriVitrini } from '../lib/projeler';

const tumProjeler = await getCollection('projeler');

const kartlar = [];
for (const kategori of kategoriler) {
  const projeler = tumProjeler.filter((p) => p.data.kategori === kategori.slug);
  if (projeler.length === 0) continue;
  const vitrin = kategoriVitrini(kategori, projeler);
  const kapak = kapakFotosu(vitrin);
  kartlar.push({
    kategori,
    sayi: projeler.length,
    gorsel: await gorsel(fotoYolu(vitrin, kapak.dosya)),
    alt: kapak.alt,
  });
}
---

<Layout
  title="Ahşap Yapı Projelerimiz ve Modellerimiz | 2K AHŞAP"
  description="Ahşap ev, bungalov, villa, tiny house, çardak ve oyun evi projelerimizi kategorilere göre inceleyin. Size özel ahşap yapı için 2K AHŞAP'tan teklif alın."
  image={kartlar[0]?.gorsel.buyuk}
>
  <section class="projeler-ust" aria-labelledby="projeler-baslik">
    <div class="kap">
      <Breadcrumb ogeler={[{ ad: 'Ana Sayfa', href: '/' }, { ad: 'Projeler' }]} />
      <h1 id="projeler-baslik">Ahşap Yapı Projelerimiz</h1>
      <p>
        Tasarlayıp ürettiğimiz ahşap yapıları kategorilere göre inceleyin. Bir kategori seçerek o
        kategorideki tüm projeleri ve fotoğraflarını görebilirsiniz.
      </p>
    </div>
  </section>

  <section class="projeler-liste" aria-label="Proje kategorileri">
    <div class="kap">
      <ul class="kart-izgara">
        {
          kartlar.map((k, i) => (
            <li>
              <Kart
                href={`/${k.kategori.slug}`}
                baslik={k.kategori.ad}
                bilgi={`${k.sayi} proje`}
                gorsel={k.gorsel}
                alt={k.alt}
                eylem="Projeleri inceleyin"
                oncelikli={i === 0}
              />
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Layout>

<style>
  .projeler-ust {
    padding-block: 16px 40px;
    background: var(--color-krem);
  }

  .projeler-ust h1 {
    margin-top: 8px;
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
  }

  .projeler-ust p {
    max-width: 65ch;
    margin: 16px 0 0;
  }

  .projeler-liste {
    padding-block: 40px 64px;
  }

  .kart-izgara {
    display: grid;
    gap: 24px;
  }

  @media (min-width: 640px) {
    .kart-izgara {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 768px) {
    .projeler-ust {
      padding-block: 24px 56px;
    }

    .projeler-liste {
      padding-block: 56px 96px;
    }
  }

  @media (min-width: 1024px) {
    .kart-izgara {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
