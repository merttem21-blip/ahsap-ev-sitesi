---
// /sss: tüm sorular gruplara göre; üstte grup kısayolları, sonda iletişim kutusu.
// Veri: src/data/sss.ts (tek kaynak). FAQPage JSON-LD tüm soruları sayfadaki sırayla (gruplara göre) kapsar.
import Layout from '../layouts/Layout.astro';
import SayfaBasi from '../components/SayfaBasi.astro';
import SssAkordeon from '../components/SssAkordeon.astro';
import { whatsappLinki } from '../data/site';
import { grubunSorulari, sssGruplari, sssSemasi } from '../data/sss';
import { jsonLd } from '../lib/projeler';

const whatsappMesaj = 'Merhaba, sıkça sorulan sorularda cevabını bulamadığım bir sorum var.';
const gruplar = sssGruplari.map((g) => ({ ...g, sorular: grubunSorulari(g.id) }));
---

<Layout
  title="Ahşap Ev ve Bungalov: Sıkça Sorulan Sorular | 2K AHŞAP"
  description="Ahşap ev ve bungalov fiyatı, ruhsat, yapım süresi, deprem dayanımı, bakım ve garanti hakkında merak edilenler. Sorunuz burada yoksa bize hemen ulaşın."
  whatsappMesaj={whatsappMesaj}
>
  <script type="application/ld+json" set:html={jsonLd(sssSemasi(gruplar.flatMap((g) => g.sorular)))} />

  <SayfaBasi
    ogeler={[{ ad: 'Ana Sayfa', href: '/' }, { ad: 'Sıkça Sorulan Sorular' }]}
    baslik="Sıkça Sorulan Sorular"
    baslikId="sss-sayfa-baslik"
    foto={{ proje: 'kiremit-catili-ahsap-ev', dosya: 'kiremit-catili-ahsap-ev-19', konum: 'center 40%' }}
  >
      <p>
        Ahşap yapı yaptırmadan önce en çok merak edilen fiyat, süre, ruhsat, malzeme ve kurulum
        sorularını yanıtladık. Projenize özel konuları teklif aşamasında birlikte netleştiriyoruz.
      </p>
      <nav class="grup-kisayollari" aria-label="Soru grupları">
        <ul>
          {
            gruplar.map((g) => (
              <li>
                <a href={`#${g.id}`} class="grup-link">
                  {g.ad}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
  </SayfaBasi>

  <div class="sss-gruplar">
    {
      gruplar.map((g) => (
        <section class="sss-grup" id={g.id} aria-labelledby={`${g.id}-baslik`}>
          <div class="kap sss-grup-ic">
            <h2 id={`${g.id}-baslik`} data-ortaya>
              {g.ad}
            </h2>
            <SssAkordeon sorular={g.sorular} />
          </div>
        </section>
      ))
    }
  </div>

  <section class="sss-son" aria-labelledby="sss-son-baslik">
    <div class="kap">
      <div class="sss-kutu" data-ortaya>
        <div>
          <h2 id="sss-son-baslik">Sorunuz burada yok mu?</h2>
          <p>
            Projenizle ilgili her soruyu yanıtlamaktan memnuniyet duyarız. Bize WhatsApp'tan yazın
            ya da teklif formunu doldurun; size en kısa sürede dönelim.
          </p>
        </div>
        <div class="sss-kutu-dugmeler">
          <a href={whatsappLinki(whatsappMesaj)} class="dugme" target="_blank" rel="noopener noreferrer">
            WhatsApp'tan Yazın
          </a>
          <a href="/teklif-al" class="dugme">Teklif Al</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Grup kısayolları: kategori linkleriyle aynı pill (marka-stili §9) */
  .grup-kisayollari {
    margin-top: var(--bosluk-4);
  }

  .grup-kisayollari ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--bosluk-1);
  }

  .grup-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 10px 18px;
    border: var(--cizgi) solid var(--color-cizgi);
    border-radius: var(--radius-tam);
    color: var(--color-metin);
    font-size: var(--text-kucuk);
    font-weight: 500;
    line-height: 1.2;
    text-decoration: none;
  }

  .grup-link::before {
    content: '';
    position: absolute;
    inset: calc(var(--cizgi) * -1);
    border: var(--cizgi) solid var(--color-ahsap);
    border-radius: inherit;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--gecis);
  }

  .grup-link:is(:hover, :focus-visible) {
    color: var(--color-krem);
  }

  .grup-link:is(:hover, :focus-visible)::before {
    opacity: 1;
  }

  .sss-gruplar {
    padding-top: var(--bosluk-6);
  }

  .sss-grup + .sss-grup {
    margin-top: var(--bosluk-6);
  }

  .sss-grup h2 {
    margin-bottom: var(--bosluk-3);
    font-size: clamp(1.5rem, 3vw, 2rem);
  }

  .sss-son {
    padding-block: var(--bolum-dar);
  }

  /* İletişim kutusu: kart yüzeyi, ince çizgi, 16px köşe */
  .sss-kutu {
    display: grid;
    gap: var(--bosluk-4);
    padding: var(--bosluk-4) var(--bosluk-3);
    border: var(--cizgi) solid var(--color-cizgi);
    border-radius: var(--radius-kart);
    background: var(--color-yuzey);
  }

  .sss-kutu h2 {
    font-size: var(--text-h2);
  }

  .sss-kutu p {
    max-width: 52ch;
    margin: var(--bosluk-2) 0 0;
  }

  .sss-kutu-dugmeler {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  /* ≥ 768px */
  @media (min-width: 768px) {
    .sss-gruplar {
      padding-top: var(--bosluk-7);
    }

    .sss-grup + .sss-grup {
      margin-top: var(--bosluk-7);
    }

    .sss-kutu {
      padding: var(--bosluk-5);
    }
  }

  /* ≥ 1024px: grup başlığı solda, sorular sağda; kutuda metin solda, butonlar sağda */
  @media (min-width: 1024px) {
    .sss-grup-ic {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
      align-items: start;
      gap: var(--bosluk-6);
    }

    .sss-grup h2 {
      margin-bottom: 0;
      padding-top: var(--bosluk-2);
    }

    .sss-kutu {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      gap: var(--bosluk-5);
      padding: var(--bosluk-6);
    }
  }
</style>
