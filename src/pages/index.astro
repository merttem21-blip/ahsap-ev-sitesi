---
// 2K AHŞAP — Ana sayfa
// Kurallar: .claude/skills/marka-stili ve .claude/skills/seo-kurallar
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Surecimiz from '../components/Surecimiz.astro';
import NedenAhsap from '../components/NedenAhsap.astro';
import SssBolumu from '../components/SssBolumu.astro';
import { ikon } from '../data/ikonlar';
import { heroGorseli, kategoriler } from '../data/site';
import { gorsel } from '../lib/gorsel';
import { anaSayfaPaylasimi } from '../lib/paylasim';
import { anaSayfaSorulari } from '../data/sss';

const baslik = 'Özel Tasarım Ahşap Ev, Bungalov ve Villa | 2K AHŞAP';
const aciklama =
  "Bungalovdan villaya, tiny house'tan kamelyaya; doğayla uyumlu, size özel ahşap ev ve yapılar tasarlayıp üretiyoruz. Projelerimizi inceleyin, teklif alın.";

// Ürün kartları: 4:5 vitrin fotoğrafları scripts/vitrin-gorseli.mjs ile aynı ışık ve renkte üretilir.
// Tek satırlık şeritte görünen kart sayısı: ≥ 1280px'te 4 (286px), ≥ 1024px'te 3, ≥ 640px'te 2; mobilde ekranın ~%78'i.
const kartBoyutu =
  '(min-width: 1280px) 286px, (min-width: 1024px) calc((100vw - 112px) / 3), (min-width: 768px) calc((100vw - 72px) / 2), (min-width: 640px) calc((100vw - 56px) / 2), 78vw';

// Kart metinleri ve sırası src/data/site.ts'deki kategorilerin anaSayfa alanından gelir
const urunler = kategoriler.flatMap((k) => (k.anaSayfa ? [{ slug: k.slug, ad: k.ad, ...k.anaSayfa }] : []));

const kartlar = await Promise.all(
  urunler.map(async (u) => ({
    ...u,
    g: await gorsel(`/images/vitrin/${u.slug}-vitrin`),
  }))
);
---

<Layout
  title={baslik}
  description={aciklama}
  image={anaSayfaPaylasimi.yol}
  imageAlt={anaSayfaPaylasimi.alt}
  seffafHeader
>
  <!-- .ana-akis: ana sayfanın bölüm ritmini (--bolum-ritim) taşır; Sürecimiz, Neden Ahşap ve SSS bunu kullanır -->
  <div class="ana-akis">
    <Hero gorsel={heroGorseli}>
      <h1 id="hero-baslik">Doğayla Uyumlu, Size Özel Ahşap Evler</h1>
      <p>
        Bungalovdan villaya, tiny house'tan kamelyaya; modern mimariyi doğal ahşapla buluşturan
        yapıları sizin için tasarlıyor ve üretiyoruz.
      </p>
      <div class="hero-dugmeler">
        <a href="/teklif-al" class="dugme">Teklif Al</a>
        <a href="/projeler" class="dugme">Projeleri İncele</a>
      </div>
    </Hero>

    <section id="kategoriler" class="urunler" aria-labelledby="kategoriler-baslik">
      <div class="kap">
        <header class="urunler-baslik" data-ortaya>
          <div>
            <p class="etiket">Ürünlerimiz</p>
            <h2 id="kategoriler-baslik">Size Özel Ahşap Yapılar</h2>
          </div>
          <p>Her yapıyı ihtiyaçlarınıza ve arazinize göre özel olarak tasarlayıp üretiyoruz.</p>
          {/* ≥ 768px'te burada; mobilde kartların altındaki kopyası görünür */}
          <a href="/projeler" class="tum-projeler tum-projeler-ust">
            Tüm projeler
            <svg class="ikon" viewBox="0 0 24 24" aria-hidden="true" set:html={ikon.ok} />
          </a>
        </header>

        {/* Kart şeridi: elle kaydırılır. Oklar (≥ 768px) ve sağ kenarın zemine karışması şeridin üstünde durur. */}
        <div class="serit-alani" data-serit-alani>
          <ul id="urun-serit" class="urun-izgara" data-ortaya-grup data-urun-serit>
            {
              kartlar.map((k) => (
                <li data-ortaya>
                  <a href={`/${k.slug}`} class="urun">
                    <img
                      class="urun-gorsel"
                      src={k.g.src}
                      srcset={k.g.srcset}
                      sizes={kartBoyutu}
                      width={k.g.width}
                      height={k.g.height}
                      alt={k.alt}
                      loading="lazy"
                      decoding="async"
                    />
                    <div class="urun-metin">
                      <h3>{k.ad}</h3>
                      <p>{k.aciklama}</p>
                      <span class="urun-eylem">
                        Modelleri inceleyin
                        <svg class="ikon" viewBox="0 0 24 24" aria-hidden="true" set:html={ikon.ok} />
                      </span>
                    </div>
                    <span class="urun-cerceve" aria-hidden="true" />
                  </a>
                </li>
              ))
            }
          </ul>
          <span class="serit-kenar" aria-hidden="true"></span>
          {/* Oklar JS ile açılır (JS yoksa şerit yalnızca elle kaydırılır); başta/sonda o taraftaki gizlenir */}
          <button
            type="button"
            class="serit-ok serit-ok-onceki"
            data-serit-ok="-1"
            aria-controls="urun-serit"
            aria-label="Önceki kartlar"
            hidden
          >
            <svg class="ikon" viewBox="0 0 24 24" aria-hidden="true" set:html={ikon.geri} />
          </button>
          <button
            type="button"
            class="serit-ok serit-ok-sonraki"
            data-serit-ok="1"
            aria-controls="urun-serit"
            aria-label="Sonraki kartlar"
            hidden
          >
            <svg class="ikon" viewBox="0 0 24 24" aria-hidden="true" set:html={ikon.ileri} />
          </button>
        </div>

        <div class="urunler-alt" data-ortaya>
          <a href="/projeler" class="tum-projeler">
            Tüm projeler
            <svg class="ikon" viewBox="0 0 24 24" aria-hidden="true" set:html={ikon.ok} />
          </a>
        </div>
      </div>
    </section>

    <Surecimiz />
    <NedenAhsap />
    <SssBolumu sorular={anaSayfaSorulari} />
  </div>
</Layout>

<script>
  // "Ürünlerimiz" kart şeridi elle kaydırılan, kartlara oturan (snap) yatay bir sıradır: mobilde parmakla,
  // masaüstünde trackpad'le ya da kartların iki yanındaki oklarla kaydırılır. Bir ok, ekranda tam görünen kart sayısı
  // kadar ilerletir. Şeridin başında "önceki", sonunda "sonraki" oku gizlenir; sonda sağ kenarın zemine karışması da
  // kaybolur.
  const serit = document.querySelector<HTMLElement>('[data-urun-serit]');
  const alan = document.querySelector<HTMLElement>('[data-serit-alani]');
  const azHareket = matchMedia('(prefers-reduced-motion: reduce)');

  // Klavyeyle odaklanan kart şeridin içinde tam görünür olur (Chrome yarısı görünen öğeyi kaydırmıyor). Yalnızca odak
  // halkası varken: fareyle ya da dokunarak tıklamada kart yerinden oynamaz, tıklama boşa gitmez.
  serit?.addEventListener('focusin', (e) => {
    const hedef = e.target as HTMLElement;
    const kart = hedef.closest('li');
    if (!kart || !hedef.matches(':focus-visible')) return;
    const s = serit.getBoundingClientRect();
    const k = kart.getBoundingClientRect();
    const ic = parseFloat(getComputedStyle(serit).paddingLeft);
    if (k.left < s.left + ic) serit.scrollLeft -= s.left + ic - k.left;
    else if (k.right > s.right - ic) serit.scrollLeft += k.right - (s.right - ic);
  });

  if (serit && alan) {
    const oklar = [...alan.querySelectorAll<HTMLButtonElement>('[data-serit-ok]')]; // önceki, sonraki
    // Bir adım: ekranda tam görünen kart sayısı kadar (en az bir kart)
    const adim = () => {
      const [ilk, ikinci] = serit.children as HTMLCollectionOf<HTMLElement>;
      const kart = ikinci.offsetLeft - ilk.offsetLeft; // kart + aralık
      const gorunen = serit.clientWidth - 2 * parseFloat(getComputedStyle(serit).paddingLeft);
      return kart * Math.max(1, Math.floor((gorunen + kart - ilk.offsetWidth) / kart + 0.01));
    };
    const guncelle = () => {
      const son = serit.scrollWidth - serit.clientWidth;
      const gizli = [serit.scrollLeft <= 1, serit.scrollLeft >= son - 1]; // başta önceki, sonda sonraki
      oklar.forEach((dugme, i) => {
        if (!gizli[i]) dugme.hidden = false;
      });
      oklar.forEach((dugme, i) => {
        if (!gizli[i] || dugme.hidden) return;
        // Odaktaki ok gizlenecekse odak diğer oka geçer (sayfanın başına kaçmaz)
        const diger = oklar[1 - i];
        if (document.activeElement === dugme && !diger.hidden) diger.focus({ preventScroll: true });
        dugme.hidden = true;
      });
      alan.toggleAttribute('data-sonda', gizli[1]);
    };
    for (const dugme of oklar)
      dugme.addEventListener('click', () => {
        serit.scrollBy({
          left: Number(dugme.dataset.seritOk) * adim(),
          behavior: azHareket.matches ? 'auto' : 'smooth',
        });
      });
    let bekleyen = 0;
    serit.addEventListener(
      'scroll',
      () => {
        bekleyen ||= requestAnimationFrame(() => {
          bekleyen = 0;
          guncelle();
        });
      },
      { passive: true }
    );
    new ResizeObserver(guncelle).observe(serit);
  }
</script>

<style>
  /* Bölüm ritmi: her bölümün üst ve alt iç boşluğu --bolum-ritim (mobil 64px, ≥ 768px 96px). Sürecimiz,
     Neden Ahşap ve SSS bu değişkeni bulursa kullanır; başka sayfalarda kendi --bolum boşluklarında kalırlar.
     Bölümleri yalnızca zemin tonu ayırır (gece ↔ ara yumuşak ton); sınırlarda çizgi ve gradyan yok. */
  .ana-akis {
    --bolum-ritim: var(--bosluk-6);
  }

  /* Ürünlerimiz: hero'dan geçiş. Hero'nun altı gece zemine erir, bölüm aynı zeminde sürer. Hero ikon şeridinin
     altındaki 48px (Hero.astro, .hero-ic) ile birlikte şeritten bölüm etiketine 2 ritim. Bölümün tamamı tek gece
     zemindir (ara tonda bant yok, şerit şeffaf); kartların altında bir ritim kalır, Sürecimiz'in üst boşluğuyla
     birlikte kartlardan sonraki bölüm etiketine yine 2 ritim.
     --serit-ic: kartların başladığı yer = .kap'ın iç boşluğu + 1280px'i aşan genişliğin yarısı (.kap ile aynı
     kırılımlar). Kullanıldığı öğede hesaplanır (cqw = bölümün genişliği); scroll-padding'de yüzde şeridin kendi
     genişliğine göre hesaplandığı için uzunlukla yazılır. */
  .urunler {
    --izgara-pay: 12px; /* şeridin dikey iç boşluğu: hover'da 6px kalkan kart ve odak halkası kırpılmasın */
    --serit-ic: calc(max(var(--bosluk-2), env(safe-area-inset-left, 0px)) + max(0px, (100cqw - 1280px) / 2));
    container-type: inline-size; /* kart şeridi bölümün tam genişliğine uzanır (cqw) */
    padding-block: calc(2 * var(--bolum-ritim) - var(--bosluk-5)) var(--bolum-ritim);
    background: var(--color-zemin);
  }

  .urunler-baslik {
    margin-bottom: var(--bosluk-4);
  }

  .urunler-baslik .etiket {
    margin-bottom: 12px;
  }

  .urunler-baslik h2 {
    font-size: var(--text-h2);
  }

  .urunler-baslik > p {
    max-width: 48ch;
    margin: var(--bosluk-2) 0 0;
  }

  /* Başlıktaki "Tüm projeler" ≥ 768px'te görünür; mobilde kartların altındaki kopyası (.urunler-alt) */
  .urunler-baslik .tum-projeler-ust {
    display: none;
  }

  /* Kart şeridi (müşteri talebi, 25 Ekim 2026): on kategori tek satırda, yatay kaydırma alanı. Şerit bölümün iki
     kenarına kadar uzanır (100cqw; 100vw gibi kaydırma çubuğu kadar taşmaz), kartlar .kap hizasından başlar ve
     sonraki kartın kenarı görünür. Elle kaydırılır ve kartlara oturur (snap); kendiliğinden kaymaz.
     Kapsayıcı (.serit-alani) okları ve sağ kenarın zemine karışmasını taşır. Dikey pay kartın hover'ı ve odak
     halkası için; negatif margin kartları başlığın altında aynı yerde, bölümün alt boşluğunu kartların alt kenarından
     başlatır. */
  .serit-alani {
    position: relative;
    margin-block: calc(var(--izgara-pay) * -1);
  }

  .urun-izgara {
    display: flex;
    gap: var(--bosluk-2);
    width: 100cqw;
    margin-inline: calc(50% - 50cqw);
    padding: var(--izgara-pay) var(--serit-ic);
    overflow-x: auto;
    overflow-y: hidden;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--serit-ic);
    scrollbar-width: none;
  }

  .urun-izgara::-webkit-scrollbar {
    display: none;
  }

  .urun-izgara > li {
    flex: 0 0 min(78%, 340px);
    scroll-snap-align: start;
  }

  /* Sağ kenarın zemine karışması (müşteri onaylı, 25 Ekim 2026): şeridin devam ettiğini gösterir. Ekranın
     kenarından son tam görünen kartın iç boşluğuna kadar uzanır (karttaki metne değmez); şeridin sonunda
     kaybolur (betikte data-sonda). Yalnızca opacity geçişi. */
  .serit-kenar {
    position: absolute;
    inset-block: 0;
    right: calc(var(--serit-ic) * -1);
    z-index: 1;
    width: calc(var(--serit-ic) + var(--bosluk-3));
    background: linear-gradient(90deg, transparent, var(--color-zemin));
    pointer-events: none;
    transition: opacity var(--sure) var(--ease-out);
  }

  [data-sonda] > .serit-kenar {
    opacity: 0;
  }

  /* Kart: görsel tüm kartı kaplar, metin alttaki karartmanın üzerinde.
     Katmanlar: görsel → metin (altında karartma) → çerçeve. Hover yalnızca transform ve opacity. */
  .urun {
    --ic: 20px; /* kart iç boşluğu */
    --ust: 72px; /* metin bloğunun üstündeki karartma geçişi */
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    isolation: isolate;
    border-radius: var(--radius-kart);
    background: var(--color-yuzey);
    color: var(--color-krem);
    text-decoration: none;
    transform: translateZ(0); /* Safari: büyüyen görsel de yuvarlak köşeye kırpılır */
    transition:
      transform var(--sure-kart) var(--ease-out),
      scale var(--gecis);
  }

  .urun-gorsel {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--sure-kart) var(--ease-out);
  }

  /* Çerçeve: dinlenmede krem %8; hover'da ahşap çerçeveli katman belirir (opacity) */
  .urun::after,
  .urun-cerceve {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    border: var(--cizgi) solid var(--color-cizgi-ince);
    border-radius: inherit;
    pointer-events: none;
  }

  .urun-cerceve {
    border-color: var(--color-ahsap);
    opacity: 0;
    transition: opacity var(--sure-kart) var(--ease-out);
  }

  .urun-metin {
    position: relative;
    z-index: 0;
    padding: var(--ust) var(--ic) var(--ic);
  }

  /* Metnin altındaki karartma metin bloğuna bağlıdır, metin uzasa da altında kalır:
     başlığın üstünde %70, açıklama ve eylemde %90 gece (fotoğrafın en açık pikselinde bile krem ≥ 4.5:1) */
  .urun-metin::before,
  .urun-metin::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .urun-metin::before {
    z-index: -2;
    background: linear-gradient(
      0deg,
      var(--color-karartma-yogun) 0,
      var(--color-karartma-yogun) 55%,
      var(--color-karartma) calc(100% - var(--ust)),
      transparent 100%
    );
  }

  /* Hover'da alttan gelen sıcak iç ışık (gölge değil; yalnızca opacity) */
  .urun-metin::after {
    z-index: -1;
    background: radial-gradient(120% 70% at 50% 100%, var(--color-ahsap-isik), transparent 70%);
    opacity: 0;
    transition: opacity var(--sure-kart) var(--ease-out);
  }

  .urun-metin h3 {
    font-size: var(--text-h3);
  }

  .urun-metin p {
    margin: var(--bosluk-1) 0 0;
    color: var(--color-krem);
    font-size: var(--text-kucuk);
    line-height: 1.55;
    opacity: 0.85;
    transition: opacity var(--sure-kart) var(--ease-out);
  }

  /* Eylem satırı; üstündeki ince ahşap çizgi kartın alt kısmını taşır */
  .urun-eylem {
    display: flex;
    align-items: center;
    gap: var(--bosluk-1);
    margin-top: var(--bosluk-2);
    padding-top: 14px;
    border-top: var(--cizgi) solid var(--color-ahsap);
    font-size: var(--text-kucuk);
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .urun-eylem .ikon {
    width: 18px;
    height: 18px;
    color: var(--color-ahsap-acik);
    transition: transform var(--sure-kart) var(--ease-out);
  }

  .urun:is(:hover, :focus-visible) {
    transform: translate3d(0, -6px, 0);
  }

  .urun:is(:hover, :focus-visible) .urun-gorsel {
    transform: scale(1.06);
  }

  .urun:is(:hover, :focus-visible) .urun-cerceve,
  .urun:is(:hover, :focus-visible) .urun-metin::after,
  .urun:is(:hover, :focus-visible) .urun-metin p {
    opacity: 1;
  }

  .urun:is(:hover, :focus-visible) .urun-eylem .ikon {
    transform: translateX(6px);
  }

  /* Mobilde "Tüm projeler" kartların altında (şeridin alt payı negatif margin'le geri alındığı için boşluk kartın
     alt kenarından ölçülür); ≥ 768px'te başlığa çıkar */
  .urunler-alt {
    display: flex;
    padding-top: var(--bosluk-4);
  }

  .tum-projeler {
    display: inline-flex;
    align-items: center;
    gap: var(--bosluk-1);
    min-height: 44px;
    color: var(--color-krem);
    font-size: var(--text-dugme);
    font-weight: 600;
    letter-spacing: 0.02em;
    text-decoration: none;
  }

  .tum-projeler .ikon {
    width: 18px;
    height: 18px;
    color: var(--color-ahsap-acik);
    transition: transform var(--gecis);
  }

  .tum-projeler:is(:hover, :focus-visible) .ikon {
    transform: translateX(4px);
  }

  /* Oklar (≥ 768px; mobilde parmakla kaydırılır): kartların iki yanında, kart yüksekliğinin ortasında. Kenar
     boşluğu 44px'lik oka yetiyorsa (≥ 1320px) ok boşluğun ortasında durur, kartlara binmez; daha dar ekranda ekran
     kenarından 4px içeride durur ve kartın kenarına biner (1024–1279px'te 16px: karttaki metne 8px kalır). Footer'daki sosyal linkler gibi ince çerçeveli daire,
     krem ikon; altındaki fotoğraf ikonu bozmasın diye yarı saydam gece zemin. Hover/odakta ahşap çerçeveli katman
     belirir (opacity), basınca %98. */
  .serit-ok {
    --ok: 44px;
    --ok-yer: max(var(--serit-ic) / -2 - var(--ok) / 2, env(safe-area-inset-left, 0px) + 4px - var(--serit-ic));
    position: absolute;
    top: 50%;
    z-index: 2;
    display: none;
    align-items: center;
    justify-content: center;
    width: var(--ok);
    height: var(--ok);
    padding: 0;
    border: var(--cizgi) solid var(--color-cizgi);
    border-radius: var(--radius-tam);
    background: var(--color-karartma);
    color: var(--color-krem);
    cursor: pointer;
    transform: translateY(-50%);
    transition: scale var(--gecis);
  }

  .serit-ok-onceki {
    left: var(--ok-yer);
  }

  .serit-ok-sonraki {
    right: var(--ok-yer);
  }

  .serit-ok::before {
    content: '';
    position: absolute;
    inset: calc(var(--cizgi) * -1);
    border: var(--cizgi) solid var(--color-ahsap);
    border-radius: inherit;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--gecis);
  }

  .serit-ok:is(:hover, :focus-visible)::before {
    opacity: 1;
  }

  .serit-ok:active {
    scale: 0.98;
  }

  /* ≥ 640px: şeritte 2 kart */
  @media (min-width: 640px) {
    .urun-izgara {
      gap: var(--bosluk-3);
    }

    .urun-izgara > li {
      flex-basis: calc((100% - var(--bosluk-3)) / 2);
    }

    .tum-projeler {
      margin-left: auto;
    }
  }

  /* ≥ 768px: "Tüm projeler" başlıkta, açıklamanın sağında ve son satırıyla aynı taban çizgisinde; alttaki satır
     kalkar. Oklar görünür (gizli olanı betik belirler). */
  @media (min-width: 768px) {
    .ana-akis {
      --bolum-ritim: var(--bosluk-7);
    }

    .urunler {
      --serit-ic: calc(max(var(--bosluk-3), env(safe-area-inset-left, 0px)) + max(0px, (100cqw - 1280px) / 2));
    }

    .urunler-baslik {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas:
        'baslik baslik'
        'aciklama link';
      align-items: end;
      align-items: last baseline;
