---
// 2K AHŞAP — Ana sayfa
// Kurallar: .claude/skills/marka-stili ve .claude/skills/seo-kurallar
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Surecimiz from '../components/Surecimiz.astro';
import NedenAhsap from '../components/NedenAhsap.astro';
import SssBolumu from '../components/SssBolumu.astro';
import { ikon } from '../data/ikonlar';
import { kategoriler } from '../data/site';
import { gorsel } from '../lib/gorsel';
import { anaSayfaSorulari } from '../data/sss';

const baslik = 'Özel Tasarım Ahşap Ev, Bungalov ve Villa | 2K AHŞAP';
const aciklama =
  "2015'ten beri 300+ projeyle özel tasarım ahşap ev, bungalov, villa ve tiny house üretiyoruz. Projelerimizi inceleyin, hemen teklif alın.";

// Hero fotoğrafları scripts/hero-gorseli.mjs ile üretilir. Birden fazla eklenirse slayt olur.
// odak: masaüstünde ev sağdaki fotoğraf alanında kalır; odakMobil: dikey ekranda verandaya ortalanır.
const heroSlaytlari = [
  {
    yol: '/images/hero/kiremit-catili-ahsap-ev-hero',
    alt: 'Spiral şimşirli bahçesi ve taş basamaklı yoluyla verandalı, kiremit çatılı ahşap ev',
    odak: '30% 60%',
    odakMobil: '58% 50%',
  },
];
const ogGorsel = (await gorsel(heroSlaytlari[0].yol)).buyuk;

// Ürün kartları: 4:5 vitrin fotoğrafları scripts/vitrin-gorseli.mjs ile aynı ışık ve renkte üretilir.
// Kartın genişliği: ≥ 1280px'te 4 sütun (286px), 640–1279px'te 2 sütun; mobilde ekranın ~%78'i (yatay şerit).
const kartBoyutu =
  '(min-width: 1280px) 286px, (min-width: 1024px) calc((100vw - 88px) / 2), (min-width: 768px) calc((100vw - 72px) / 2), (min-width: 640px) calc((100vw - 56px) / 2), 78vw';

const urunler = [
  {
    slug: 'ahsap-ev',
    alt: 'Gri çatılı verandalı ahşap ev – taş kaideli köşe veranda',
    aciklama: 'Ailenizin ihtiyaçlarına göre tasarlanan, uzun ömürlü ve sıcak yaşam alanları.',
  },
  {
    slug: 'bungalov',
    alt: 'Geniş verandalı asma katlı bungalov – cam üçgen cephe ve ön veranda',
    aciklama: 'Bahçeniz, tatil eviniz veya turizm tesisiniz için doğayla uyumlu bungalovlar.',
  },
  {
    slug: 'villa',
    alt: 'Geniş verandalı ahşap villa – köşeden uzun kavisli saçak ve veranda',
    aciklama: 'Geniş verandalı, ferah planlı; modern mimariyle doğal ahşabı buluşturan villalar.',
  },
  {
    slug: 'tiny-house',
    alt: 'Lombar pencereli modern tiny house – çevresi teraslı yan cephe',
    aciklama: 'Az alanda konforlu yaşam: kompakt, işlevsel ve size özel tasarım.',
  },
];

const kartlar = await Promise.all(
  urunler.map(async (u, i) => ({
    ...u,
    ad: kategoriler.find((k) => k.slug === u.slug)!.ad,
    no: String(i + 1).padStart(2, '0'),
    g: await gorsel(`/images/vitrin/${u.slug}-vitrin`),
  }))
);

// Kartı olmayan kategoriler kartların altında pill link olarak listelenir
const digerKategoriler = kategoriler.filter((k) => !urunler.some((u) => u.slug === k.slug));
---

<Layout title={baslik} description={aciklama} image={ogGorsel} seffafHeader>
  <Hero slaytlar={heroSlaytlari}>
    <h1 id="hero-baslik">Doğayla Uyumlu, Size Özel Ahşap Evler</h1>
    <p>
      Bungalovdan villaya, tiny house'tan çardağa; modern mimariyi doğal ahşapla buluşturan
      yapıları sizin için tasarlıyor ve üretiyoruz.
    </p>
    <div class="hero-dugmeler">
      <a href="/iletisim" class="dugme">Teklif Al</a>
      <a href="/projeler" class="dugme">Projeleri İncele</a>
    </div>
  </Hero>

  <section id="kategoriler" class="urunler" aria-labelledby="kategoriler-baslik">
    <div class="kap">
      <header class="urunler-baslik" data-ortaya>
        <div>
          <p class="etiket">Ürünlerimiz</p>
          <h2 id="kategoriler-baslik">Size Özel Ahşap Yapılar</h2>
        </div>
        <p>Her yapıyı ihtiyaçlarınıza ve arazinize göre özel olarak tasarlayıp üretiyoruz.</p>
      </header>
    </div>

    <div class="urunler-govde">
      <div class="kap">
        <ul class="urun-izgara" data-ortaya-grup>
          {
            kartlar.map((k) => (
              <li data-ortaya>
                <a href={`/${k.slug}`} class="urun">
                  <img
                    class="urun-gorsel"
                    src={k.g.src}
                    srcset={k.g.srcset}
                    sizes={kartBoyutu}
                    width={k.g.width}
                    height={k.g.height}
                    alt={k.alt}
                    loading="lazy"
                    decoding="async"
                  />
                  <span class="urun-no" aria-hidden="true">
                    {k.no}
                  </span>
                  <div class="urun-metin">
                    <h3>{k.ad}</h3>
                    <p>{k.aciklama}</p>
                    <span class="urun-eylem">
                      Modelleri inceleyin
                      <svg class="ikon" viewBox="0 0 24 24" aria-hidden="true" set:html={ikon.ok} />
                    </span>
                  </div>
                  <span class="urun-cerceve" aria-hidden="true" />
                </a>
              </li>
            ))
          }
        </ul>

        <div class="urunler-alt" data-ortaya>
          <nav aria-label="Diğer kategoriler">
            <ul class="kategori-linkleri">
              {
                digerKategoriler.map((k) => (
                  <li>
                    <a href={`/${k.slug}`} class="kategori-link">
                      {k.ad}
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>
          <a href="/projeler" class="tum-projeler">
            Tüm projeler
            <svg class="ikon" viewBox="0 0 24 24" aria-hidden="true" set:html={ikon.ok} />
          </a>
        </div>
      </div>
    </div>
  </section>

  <Surecimiz />
  <NedenAhsap />
  <SssBolumu sorular={anaSayfaSorulari} />
</Layout>

<style>
  /* Ürünlerimiz: hero'dan geçiş.
     Hero'nun altı gece zemine erir; bölüm başlığı ve kartların üst kısmı (--bindirme) bu zeminde kalır,
     kartların gerisi antrasit banda oturur. Kartlar iki tonun sınırına biner (masaüstünde 80px). */
  .urunler {
    --bindirme: 48px;
    padding-top: var(--bosluk-5);
    background: var(--color-zemin);
    border-bottom: var(--cizgi) solid var(--color-cizgi);
  }

  .urunler-baslik {
    margin-bottom: var(--bosluk-4);
  }

  .urunler-baslik .etiket {
    margin-bottom: 12px;
  }

  .urunler-baslik h2 {
    font-size: var(--text-h2);
  }

  .urunler-baslik > p {
    max-width: 48ch;
    margin: var(--bosluk-2) 0 0;
  }

  .urunler-govde {
    position: relative;
    isolation: isolate;
    padding-bottom: var(--bolum);
  }

  .urunler-govde::before {
    content: '';
    position: absolute;
    inset: var(--bindirme) 0 0;
    z-index: -1;
    border-top: var(--cizgi) solid var(--color-cizgi);
    background: var(--color-zemin-ara);
  }

  /* Mobil: yatay kaydırmalı şerit. Şerit ekran kenarına kadar uzar, kartlar .kap hizasında durur;
     sonraki kartın kenarı görünür kalır (kaydırılabildiği anlaşılır). */
  .urun-izgara {
    display: flex;
    gap: var(--bosluk-2);
    margin-inline: calc(var(--bosluk-2) * -1);
    padding: 6px var(--bosluk-2); /* odak halkası ve kenarlar kırpılmasın */
    overflow-x: auto;
    overflow-y: hidden;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--bosluk-2);
    scrollbar-width: none;
  }

  .urun-izgara::-webkit-scrollbar {
    display: none;
  }

  .urun-izgara > li {
    flex: 0 0 min(78%, 340px);
    scroll-snap-align: start;
  }

  /* Kart: görsel tüm kartı kaplar, metin alttaki karartmanın üzerinde.
     Katmanlar: görsel → üst karartma → numara ve metin → çerçeve. Hover yalnızca transform ve opacity. */
  .urun {
    --ic: 20px; /* kart iç boşluğu */
    --ust: 72px; /* metin bloğunun üstündeki karartma geçişi */
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    isolation: isolate;
    border-radius: var(--radius-kart);
    background: var(--color-yuzey);
    color: var(--color-krem);
    text-decoration: none;
    transform: translateZ(0); /* Safari: büyüyen görsel de yuvarlak köşeye kırpılır */
    transition:
      transform var(--sure-kart) var(--ease-out),
      scale var(--gecis);
  }

  .urun-gorsel {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--sure-kart) var(--ease-out);
  }

  /* Üst kenar: numaranın okunması için hafif gece karartması */
  .urun::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    z-index: -1;
    height: 35%;
    background: linear-gradient(180deg, var(--color-karartma-orta), transparent);
    pointer-events: none;
  }

  /* Çerçeve: dinlenmede krem %8; hover'da ahşap çerçeveli katman belirir (opacity) */
  .urun::after,
  .urun-cerceve {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    border: var(--cizgi) solid var(--color-cizgi-ince);
    border-radius: inherit;
    pointer-events: none;
  }

  .urun-cerceve {
    border-color: var(--color-ahsap);
    opacity: 0;
    transition: opacity var(--sure-kart) var(--ease-out);
  }

  /* Dekoratif sıra numarası (ekran okuyucudan gizli) */
  .urun-no {
    position: absolute;
    top: var(--ic);
    left: var(--ic);
    color: var(--color-ahsap-acik);
    font-size: var(--text-etiket);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    letter-spacing: var(--aralik-etiket);
    line-height: 1;
  }

  .urun-metin {
    position: relative;
    z-index: 0;
    padding: var(--ust) var(--ic) var(--ic);
  }

  /* Metnin altındaki karartma metin bloğuna bağlıdır, metin uzasa da altında kalır:
     başlığın üstünde %70, açıklama ve eylemde %90 gece (fotoğrafın en açık pikselinde bile krem ≥ 4.5:1) */
  .urun-metin::before,
  .urun-metin::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .urun-metin::before {
    z-index: -2;
    background: linear-gradient(
      0deg,
      var(--color-karartma-yogun) 0,
      var(--color-karartma-yogun) 55%,
      var(--color-karartma) calc(100% - var(--ust)),
      transparent 100%
    );
  }

  /* Hover'da alttan gelen sıcak iç ışık (gölge değil; yalnızca opacity) */
  .urun-metin::after {
    z-index: -1;
    background: radial-gradient(120% 70% at 50% 100%, var(--color-ahsap-isik), transparent 70%);
    opacity: 0;
    transition: opacity var(--sure-kart) var(--ease-out);
  }

  .urun-metin h3 {
    font-size: var(--text-h3);
  }

  .urun-metin p {
    margin: var(--bosluk-1) 0 0;
    color: var(--color-krem);
    font-size: var(--text-kucuk);
    line-height: 1.55;
    opacity: 0.85;
    transition: opacity var(--sure-kart) var(--ease-out);
  }

  /* Eylem satırı; üstündeki ince ahşap çizgi kartın alt kısmını taşır */
  .urun-eylem {
    display: flex;
    align-items: center;
    gap: var(--bosluk-1);
    margin-top: var(--bosluk-2);
    padding-top: 14px;
    border-top: var(--cizgi) solid var(--color-ahsap);
    font-size: var(--text-kucuk);
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .urun-eylem .ikon {
    width: 18px;
    height: 18px;
    color: var(--color-ahsap-acik);
    transition: transform var(--sure-kart) var(--ease-out);
  }

  .urun:is(:hover, :focus-visible) {
    transform: translate3d(0, -6px, 0);
  }

  .urun:is(:hover, :focus-visible) .urun-gorsel {
    transform: scale(1.06);
  }

  .urun:is(:hover, :focus-visible) .urun-cerceve,
  .urun:is(:hover, :focus-visible) .urun-metin::after,
  .urun:is(:hover, :focus-visible) .urun-metin p {
    opacity: 1;
  }

  .urun:is(:hover, :focus-visible) .urun-eylem .ikon {
    transform: translateX(6px);
  }

  /* Kartların altı: diğer kategoriler (pill) ve tüm projeler linki */
  .urunler-alt {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--bosluk-3) var(--bosluk-4);
    margin-top: var(--bosluk-5);
  }

  .kategori-linkleri {
    display: flex;
    flex-wrap: wrap;
    gap: var(--bosluk-1);
  }

  .kategori-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 10px 18px;
    border: var(--cizgi) solid var(--color-cizgi);
    border-radius: var(--radius-tam);
    color: var(--color-metin);
    font-size: var(--text-kucuk);
    font-weight: 500;
    line-height: 1.2;
    text-decoration: none;
  }

  .kategori-link::before {
    content: '';
    position: absolute;
    inset: calc(var(--cizgi) * -1);
    border: var(--cizgi) solid var(--color-ahsap);
    border-radius: inherit;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--gecis);
  }

  .kategori-link:is(:hover, :focus-visible) {
    color: var(--color-krem);
  }

  .kategori-link:is(:hover, :focus-visible)::before {
    opacity: 1;
  }

  .tum-projeler {
    display: inline-flex;
    align-items: center;
    gap: var(--bosluk-1);
    min-height: 44px;
    color: var(--color-krem);
    font-size: var(--text-dugme);
    font-weight: 600;
    letter-spacing: 0.02em;
    text-decoration: none;
  }

  .tum-projeler .ikon {
    width: 18px;
    height: 18px;
    color: var(--color-ahsap-acik);
    transition: transform var(--gecis);
  }

  .tum-projeler:is(:hover, :focus-visible) .ikon {
    transform: translateX(4px);
  }

  /* ≥ 640px: 2 × 2 ızgara (1024px'te 4 sütun kartı ~220px'e düşürür, metin fotoğrafı örter; iPad yatay da buradadır) */
  @media (min-width: 640px) {
    .urunler {
      --bindirme: 64px;
    }

    .urun-izgara {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--bosluk-3);
      margin-inline: 0;
      padding: 0;
      overflow: visible;
      scroll-snap-type: none;
    }

    .tum-projeler {
      margin-left: auto;
    }
  }

  /* ≥ 768px */
  @media (min-width: 768px) {
    .urun {
      --ic: 24px;
      --ust: 80px;
    }
  }

  /* ≥ 1024px: başlık solda, açıklama sağda */
  @media (min-width: 1024px) {
    .urunler {
      --bindirme: 80px;
    }

    .urunler-baslik {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 24rem);
      align-items: end;
      gap: var(--bosluk-5);
      margin-bottom: var(--bosluk-5);
    }

    .urunler-baslik > p {
      margin: 0;
    }
  }

  /* ≥ 1280px: 4 kart yan yana (286px) */
  @media (min-width: 1280px) {
    .urun-izgara {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
