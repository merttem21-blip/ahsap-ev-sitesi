---
// 2K AHŞAP — Ana sayfa
// Kurallar: .claude/skills/marka-stili ve .claude/skills/seo-kurallar
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import { ikon } from '../data/ikonlar';
import { gorsel } from '../lib/gorsel';

const baslik = 'Özel Tasarım Ahşap Ev, Bungalov ve Villa | 2K AHŞAP';
const aciklama =
  "2015'ten beri 300+ projeyle özel tasarım ahşap ev, bungalov, villa ve tiny house üretiyoruz. Projelerimizi inceleyin, hemen teklif alın.";

// Görseller public/images altında -600 / -1000 / -1600 genişliklerinde hazır.
const srcset = (yol: string) =>
  [600, 1000, 1600].map((g) => `${yol}-${g}.webp ${g}w`).join(', ');

// Hero fotoğrafları scripts/hero-gorseli.mjs ile üretilir. Birden fazla eklenirse slayt olur.
// odak: masaüstünde ev sağdaki fotoğraf alanında kalır; odakMobil: dikey ekranda verandaya ortalanır.
const heroSlaytlari = [
  {
    yol: '/images/hero/kiremit-catili-ahsap-ev-hero',
    alt: 'Spiral şimşirli bahçesi ve taş basamaklı yoluyla verandalı, kiremit çatılı ahşap ev',
    odak: '30% 60%',
    odakMobil: '58% 50%',
  },
];
const ogGorsel = (await gorsel(heroSlaytlari[0].yol)).buyuk;

// Panoramik (20:9) görseller 4:3 karta kırpıldığı için daha geniş kaynak ister.
const boyutNormal = '(min-width: 1280px) 300px, (min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw';
const boyutPanoramik = '(min-width: 1280px) 500px, (min-width: 1024px) 42vw, (min-width: 640px) 84vw, 167vw';

const kategoriler = [
  {
    ad: 'Ahşap Ev',
    href: '/ahsap-ev',
    yol: '/images/ahsap-ev/gri-catili-verandali-ahsap-ev/gri-catili-verandali-ahsap-ev-01',
    genislik: 1600,
    yukseklik: 1200,
    boyut: boyutNormal,
    alt: 'Gri çatılı verandalı ahşap ev – taş kaideli köşe veranda',
    aciklama: 'Ailenizin ihtiyaçlarına göre tasarlanan, uzun ömürlü ve sıcak yaşam alanları.',
  },
  {
    ad: 'Bungalov',
    href: '/bungalov',
    yol: '/images/bungalov/asma-katli-verandali-bungalov/asma-katli-verandali-bungalov-01',
    genislik: 1600,
    yukseklik: 1200,
    boyut: boyutNormal,
    alt: 'Shingle çatılı, ön verandalı ahşap bungalov ve arkasında dağ manzarası',
    aciklama: 'Bahçeniz, tatil eviniz veya turizm tesisiniz için doğayla uyumlu bungalovlar.',
  },
  {
    ad: 'Villa',
    href: '/villa',
    yol: '/images/villa/genis-verandali-ahsap-villa/genis-verandali-ahsap-villa-01',
    genislik: 1600,
    yukseklik: 720,
    boyut: boyutPanoramik,
    alt: 'Taş kaideli, çevresi verandalı ahşap villa ve bahçe yolu',
    aciklama: 'Geniş verandalı, ferah planlı; modern mimariyle doğal ahşabı buluşturan villalar.',
  },
  {
    ad: 'Tiny House',
    href: '/tiny-house',
    yol: '/images/tiny-house/lombar-pencereli-modern-tiny-house/lombar-pencereli-modern-tiny-house-01',
    genislik: 1600,
    yukseklik: 720,
    boyut: boyutPanoramik,
    alt: 'Yuvarlak pencereli, geniş ahşap terasa sahip tiny house',
    aciklama: 'Az alanda konforlu yaşam: kompakt, işlevsel ve size özel tasarım.',
  },
];
---

<Layout title={baslik} description={aciklama} image={ogGorsel} seffafHeader>
  <Hero slaytlar={heroSlaytlari}>
    <h1 id="hero-baslik">Doğayla Uyumlu, Size Özel Ahşap Evler</h1>
    <p>
      Bungalovdan villaya, tiny house'tan çardağa; modern mimariyi doğal ahşapla buluşturan
      yapıları sizin için tasarlıyor ve üretiyoruz.
    </p>
    <div class="hero-dugmeler">
      <a href="/iletisim" class="dugme">Teklif Al</a>
      <a href="#kategoriler" class="dugme">Projeleri İncele</a>
    </div>
  </Hero>

  <section id="kategoriler" class="kategoriler" aria-labelledby="kategoriler-baslik">
    <div class="kap">
      <header class="bolum-baslik" data-ortaya>
        <p class="bolum-etiket">Ürünlerimiz</p>
        <h2 id="kategoriler-baslik">Size Özel Ahşap Yapılar</h2>
        <p>
          Her yapıyı ihtiyaçlarınıza ve arazinize göre özel olarak tasarlayıp üretiyoruz.
        </p>
      </header>

      <ul class="kart-izgara">
        {
          kategoriler.map((k) => (
            <li data-ortaya>
              <a href={k.href} class="kart">
                <div class="kart-gorsel">
                  <img
                    src={`${k.yol}-600.webp`}
                    srcset={srcset(k.yol)}
                    sizes={k.boyut}
                    width={k.genislik}
                    height={k.yukseklik}
                    alt={k.alt}
                    loading="lazy"
                    decoding="async"
                  />
                </div>
                <div class="kart-govde">
                  <h3>{k.ad}</h3>
                  <p>{k.aciklama}</p>
                  <span class="kart-link">
                    Modelleri inceleyin
                    <svg class="ikon" viewBox="0 0 24 24" aria-hidden="true" set:html={ikon.ok} />
                  </span>
                </div>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Layout>

<style>
  /* Kategoriler */
  .kategoriler {
    padding-block: 64px;
    background: var(--color-zemin);
  }

  .bolum-baslik {
    max-width: 640px;
    margin-bottom: 40px;
  }

  .bolum-etiket {
    margin: 0 0 8px;
    color: var(--color-ahsap-acik);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .bolum-baslik h2 {
    font-size: clamp(1.5rem, 3.5vw, 2.5rem);
    font-weight: 600;
  }

  .bolum-baslik p:last-child {
    margin: 16px 0 0;
  }

  .kart-izgara {
    display: grid;
    gap: 24px;
  }

  .kart {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border: var(--cizgi) solid var(--color-cizgi);
    border-radius: var(--radius);
    background: var(--color-yuzey);
    text-decoration: none;
  }

  .kart-gorsel {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--color-yuzey);
  }

  .kart-gorsel img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 300ms ease-out;
  }

  .kart:hover .kart-gorsel img {
    transform: scale(1.03);
  }

  .kart-govde {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 24px;
  }

  .kart h3 {
    font-size: clamp(1.25rem, 2.5vw, 1.5rem);
    font-weight: 600;
  }

  .kart p {
    flex: 1;
    margin: 8px 0 20px;
  }

  .kart-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--color-ahsap-acik);
    font-weight: 600;
  }

  .kart-link .ikon {
    transition: transform var(--gecis);
  }

  .kart:hover .kart-link .ikon {
    transform: translateX(4px);
  }

  /* ≥ 640px */
  @media (min-width: 640px) {
    .kart-izgara {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* ≥ 768px */
  @media (min-width: 768px) {
    .kategoriler {
      padding-block: 96px;
    }
  }

  /* ≥ 1024px */
  @media (min-width: 1024px) {
    .kart-izgara {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
