---
// Kategori sayfaları (/bungalov, /villa, ...): o kategorideki proje kartları.
// Henüz projesi olmayan kategori "Yakında" gösterir ve noindex kalır.
// Sayfa sonunda kategoriye uygun 3–4 soru (src/data/sss.ts).
import Layout from '../layouts/Layout.astro';
import SayfaBasi from '../components/SayfaBasi.astro';
import ProjeKarti from '../components/ProjeKarti.astro';
import Yakinda from '../components/Yakinda.astro';
import SssBolumu from '../components/SssBolumu.astro';
import { kategoriler, whatsappLinki } from '../data/site';
import { kategoriSorulari } from '../data/sss';
import { kategoriPaylasimi } from '../lib/paylasim';
import {
  kapakFotosu,
  kategoriMetaAciklamasi,
  kategoriMetaBasligi,
  kategoriProjeleri,
  kategoriVitrini,
} from '../lib/projeler';

export function getStaticPaths() {
  return kategoriler.map((k) => ({ params: { kategori: k.slug }, props: { kategori: k } }));
}

const { kategori } = Astro.props;
const projeler = await kategoriProjeleri(kategori.slug);
const ilk = projeler[0];
// Başlık bandının fotoğrafı: kategoriyi temsil eden (vitrin) projenin kapak fotoğrafı
const vitrin = ilk ? kategoriVitrini(kategori, projeler) : undefined;
const whatsappMesaj = `Merhaba, ${kategori.ad} projeleriniz hakkında bilgi almak istiyorum.`;
// Bağlantı önizlemesi: kategoriyi temsil eden projenin kapağından (projesi yoksa logolu varsayılan görsel)
const paylasim = await kategoriPaylasimi(kategori, projeler);
---

<Layout
  title={kategoriMetaBasligi(kategori)}
  description={kategoriMetaAciklamasi(kategori)}
  image={paylasim.yol}
  imageAlt={paylasim.alt}
  noindex={!ilk}
  whatsappMesaj={whatsappMesaj}
  teklifAdresi={`/teklif-al?yapi=${kategori.slug}`}
>
  {
    ilk ? (
      <>
        <SayfaBasi
          ogeler={[{ ad: 'Ana Sayfa', href: '/' }, { ad: kategori.ad }]}
          baslik={kategori.h1}
          baslikId="kategori-baslik"
          foto={vitrin && { proje: vitrin.slug, dosya: kapakFotosu(vitrin).dosya }}
        >
          <p>
            {kategori.giris} Bir projeye tıklayarak tüm fotoğraflarını inceleyebilirsiniz.
          </p>
        </SayfaBasi>

        <section class="kategori-projeler" aria-label={`${kategori.ad} projeleri`}>
          <div class="kap">
            <ul class="proje-izgara">
              {projeler.map((p) => (
                <li data-ortaya>
                  <ProjeKarti proje={p} />
                </li>
              ))}
            </ul>
          </div>
        </section>
      </>
    ) : (
      <Yakinda
        baslik={`${kategori.ad} Projelerimiz`}
        metin="Bu kategorideki projelerimizin fotoğraflarını yakında bu sayfada yayınlayacağız. Bu sırada projeniz için bizi arayabilir veya WhatsApp'tan yazabilirsiniz."
        whatsapp={whatsappLinki(whatsappMesaj)}
      />
    )
  }

  <SssBolumu
    sorular={kategoriSorulari(kategori.slug)}
    baslik={`${kategori.ad} Hakkında Sıkça Sorulan Sorular`}
    ustCizgi
  />
</Layout>

<style>
  .kategori-projeler {
    padding-block: 40px 64px;
  }

  .proje-izgara {
    display: grid;
    gap: 24px;
  }

  @media (min-width: 640px) {
    .proje-izgara {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 768px) {
    .kategori-projeler {
      padding-block: 56px 96px;
    }
  }

  @media (min-width: 1024px) {
    .proje-izgara {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
