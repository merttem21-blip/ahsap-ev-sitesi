---
// Hakkımızda: tanıtım, hikâye, vizyon ve misyon, Neden 2K Ahşap ve çalışma süreci (müşteri onaylı düzen, 15 Ekim 2026;
// docs/hakkimizda/yeniden-tasarim/; alıntı bandı ve hikâye fotoğrafı: docs/hakkimizda/duzeltme/; açılış:
// docs/hakkimizda/acilis/). Ekip sonraki aşamada eklenecek.
// Akış ve zemin: açılış fotoğrafı (altında breadcrumb ve H1'i taşıyan ince bant, düz gece karartması) → tanıtım
// metni (gece) → Hikâyemiz (gece; 4:5 fotoğraf solda, metin sağda) → büyük alıntı (tam genişlikte ara yumuşak tonlu bant, ortalı) → Vizyonumuz / Misyonumuz (gece; ahşap
// üst çizgili iki açık panel) →
// Neden 2K Ahşap (ara yumuşak ton) → tam genişlik fotoğraf bandı → Sürecimiz (gece) → footer teklif bandı.
// Bölüm boşlukları ana sayfanın ritmiyle aynıdır (--bolum-ritim: mobil 64px, ≥ 768px 96px); Neden 2K Ahşap ve
// Sürecimiz bu değişkeni kendiliğinden kullanır.
// Fotoğraflar yalnızca proje galerilerinde zaten yayında olan fotoğraflardır; alt metinleri projenin kendi kaydından
// gelir (src/content/projeler). Proje veya fotoğraf kaldırılırsa derleme durur.
import { getEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import NedenAhsap from '../components/NedenAhsap.astro';
import Surecimiz from '../components/Surecimiz.astro';
import { gorsel } from '../lib/gorsel';
import { fotoYolu } from '../lib/projeler';

async function projeFotosu(proje: string, dosya: string) {
  const kayit = await getEntry('projeler', proje);
  const foto = kayit?.data.fotograflar.find((f) => f.dosya === dosya);
  if (!kayit || !foto) throw new Error(`[hakkımızda] Proje fotoğrafı bulunamadı: ${proje}/${dosya}`);
  return { ...(await gorsel(fotoYolu(kayit, dosya))), alt: foto.alt };
}

// Açılış iki kadrajla verilir (art direction): < 1024px'te açılış dikeydir, aynı salonun dikey fotoğrafı kullanılır;
// yatay fotoğraf bu alana ~3,5 kat büyütülüp bulanıklaşırdı. ≥ 1024px'te yatay fotoğraf. Alt metni dikey
// fotoğrafınkidir; iki kadrajda da görünen şeyi (kirişli tavan, salon penceresi) anlatır.
const [acilis, acilisGenis, hikaye, bant] = await Promise.all([
  projeFotosu('tas-kaideli-verandali-ahsap-ev', 'tas-kaideli-verandali-ahsap-ev-04'),
  projeFotosu('tas-kaideli-verandali-ahsap-ev', 'tas-kaideli-verandali-ahsap-ev-07'),
  projeFotosu('kemerli-pod-bungalov', 'kemerli-pod-bungalov-02'),
  projeFotosu('genis-verandali-ahsap-villa', 'genis-verandali-ahsap-villa-05'),
]);
---

<Layout
  title="Hakkımızda: Hikâyemiz, Vizyonumuz ve Misyonumuz | 2K AHŞAP"
  description="2015'ten beri ahşap ev ve yapıları tasarlıyor, üretiyor ve kuruyoruz. Hikâyemizi, vizyon ve misyonumuzu, çalışma biçimimizi ve sürecimizi tanıyın."
>
  <div class="hakkimizda-akis">
    <section class="acilis" aria-labelledby="hakkimizda-baslik">
      <div class="acilis-gorsel">
        <picture>
          <source
            media="(min-width: 1024px)"
            srcset={acilisGenis.srcset}
            sizes="100vw"
            width={acilisGenis.width}
            height={acilisGenis.height}
          />
          <!-- < 1024px: aynı salonun dikey fotoğrafı; kutu fotoğraftan yatık olduğu için genişliğe oturur -->
          <img
            class="acilis-foto"
            src={acilis.src}
            srcset={acilis.srcset}
            sizes="100vw"
            width={acilis.width}
            height={acilis.height}
            alt={acilis.alt}
            loading="eager"
            fetchpriority="high"
          />
        </picture>
        <div class="acilis-bant">
          <div class="kap acilis-ic">
            <Breadcrumb ogeler={[{ ad: 'Ana Sayfa', href: '/' }, { ad: 'Hakkımızda' }]} />
            <h1 id="hakkimizda-baslik">Hakkımızda</h1>
          </div>
        </div>
      </div>
      <!-- Tanıtım fotoğrafın üstünde değil, düz gece zeminde: bant ince kalır, H1 her ekranda ilk ekranda görünür -->
      <div class="kap acilis-metin">
        <p class="giris">
          2K AHŞAP, 2015 yılından beri Türkiye'de ahşap ev ve yapıları özel olarak tasarlayıp
          üretiyor. Pendik/İstanbul merkezli ekibimizle bungalovdan villaya, tiny house'tan çardağa,
          otel ve bar yapılarından çocuk oyun parklarına kadar farklı ihtiyaçlara yapılar hazırlıyoruz.
          Modern mimariyi doğal malzemeyle harmanlıyor, her projeyi arazinize ve beklentilerinize göre
          sizinle birlikte şekillendiriyoruz.
        </p>
      </div>
    </section>

    <section class="hikaye" aria-labelledby="hikaye-baslik">
      <div class="kap">
        <div class="hikaye-izgara">
          <div class="hikaye-metin" data-ortaya>
            <h2 id="hikaye-baslik">Hikâyemiz</h2>
            <p>
              Her şey, bir ağacın gövdesindeki halkalara bakarken duyulan o sessiz hayranlıkla başladı.
              Ahşap, yıllar boyunca rüzgârı, yağmuru ve güneşi içinde biriktirir; işlendiğinde bu
              birikimi yaşadığımız mekâna, soluduğumuz havaya, dokunduğumuz her yüzeye taşır. Biz de
              ahşabı tam bu yüzden seçtik. Çünkü bir ev yalnızca duvarlardan ve çatıdan ibaret değildir;
              içinde kurulan hayallerin, paylaşılan sofraların ve büyüyen çocukların hikâyesidir.
            </p>
            <p>
              Ahşaba duyduğumuz ilgi, çocukluk yıllarımıza uzanan bir merakla başladı. Bir tahta
              parçasından yeni bir şey yaratmanın heyecanı yıllar içinde bir tutkuya, 2015'te ise 2K
              AHŞAP'a dönüştü. Amacımız o günden beri aynı: insanların doğayla yeniden bağ kurabileceği
              yaşam alanları üretmek. İlk projemizden bu yana değişmeyen tek bir ilkemiz var: Her yapıya,
              kendi evimizi inşa ediyormuş gibi yaklaşmak. Bir bungalovun verandasında içilen ilk çay, bir
              tiny house'un penceresinden izlenen ilk gün doğumu, bir bahçe çardağında kurulan ilk sofra…
              Bizim için asıl başarı, teslim ettiğimiz her yapının içinde güzel anıların birikmeye
              başlamasıdır.
            </p>
            <p>
              Bugün aynı heyecanla çalışıyor; doğadan aldığımız ilhamı, özenle ve ustalıkla şekillenen
              yapılara dönüştürmeye devam ediyoruz.
            </p>
          </div>
          <!-- Görsel kadraja 1,36 kat yakınlaştırılır (CSS); sizes bu genişliği anlatır -->
          <div class="hikaye-foto" data-ortaya>
            <img
              src={hikaye.src}
              srcset={hikaye.srcset}
              sizes="(min-width: 1280px) 616px, (min-width: 1024px) 48vw, (min-width: 768px) 609px, calc(136vw - 44px)"
              width={hikaye.width}
              height={hikaye.height}
              alt={hikaye.alt}
              loading="lazy"
              decoding="async"
            />
          </div>
        </div>
      </div>

      <!-- Alıntı, Hikâyemiz'deki cümlenin büyük puntolu tekrarıdır; ekran okuyucu iki kez okumasın -->
      <div class="alinti-blok" aria-hidden="true">
        <div class="kap" data-ortaya>
          <p class="alinti">Her yapıya, kendi evimizi inşa ediyormuş gibi yaklaşmak.</p>
        </div>
      </div>
    </section>

    <section class="degerler" aria-label="Vizyonumuz ve misyonumuz">
      <div class="kap degerler-izgara">
        <article class="deger" aria-labelledby="vizyon-baslik" data-ortaya>
          <h2 id="vizyon-baslik">Vizyonumuz</h2>
          <p>
            Doğal ahşabın sıcaklığını çağdaş mimarinin işlevselliğiyle buluşturarak, ahşap yapı
            alanında kalitesi, güvenilirliği ve tasarım anlayışıyla örnek gösterilen bir marka olmak.
            Doğaya saygılı üretim anlayışımızı her projeye taşıyarak, uzun ömürlü, sağlıklı ve
            çevresiyle uyumlu yaşam alanlarının yaygınlaşmasına öncülük etmeyi; konuttan turizme,
            bahçe yapılarından özel tasarımlara kadar ahşabın sunduğu imkânları daha geniş kitlelerle
            buluşturmayı hedefliyoruz.
          </p>
        </article>
        <article class="deger" aria-labelledby="misyon-baslik" data-ortaya>
          <h2 id="misyon-baslik">Misyonumuz</h2>
          <p>
            Her projeyi, müşterimizin ihtiyaçlarını, arazisinin koşullarını ve hayalindeki yaşam
            alanını merkeze alarak tasarlamak; doğru malzeme seçimi, özenli işçilik ve teknik
            titizlikle hayata geçirmek. Tasarımdan üretime, üretimden uygulamaya kadar sürecin her
            aşamasında şeffaf, ulaşılabilir ve çözüm odaklı bir iş ortağı olmak; verdiğimiz her sözü
            eksiksiz yerine getirerek müşterilerimizle uzun soluklu ve güvene dayalı ilişkiler kurmak.
            Ahşabı yalnızca bir yapı malzemesi olarak değil, doğayla kurulan bir bağ olarak görüyor ve
            her yapıyı bu sorumlulukla üretiyoruz.
          </p>
        </article>
      </div>
    </section>

    <NedenAhsap />

    <div class="foto-bant">
      <img
        src={bant.src}
        srcset={bant.srcset}
        sizes="100vw"
        width={bant.width}
        height={bant.height}
        alt={bant.alt}
        loading="lazy"
        decoding="async"
      />
    </div>

    <Surecimiz />
  </div>
</Layout>

<style>
  /* Bölüm ritmi: ana sayfayla aynı (index.astro, .ana-akis) */
  .hakkimizda-akis {
    --bolum-ritim: var(--bosluk-6);
  }

  /* Açılış (müşteri onaylı, docs/hakkimizda/acilis/): tam genişlik fotoğraf; altında yalnızca breadcrumb ve H1'i
     taşıyan ince bant. Bandın zemini düz gece karartması (%70; galerideki bilgi bandıyla aynı yöntem): fotoğrafın en
     açık yerinde bile krem metin ≥ 4.5:1 (marka-stili §2). Bant fotoğrafın en az üçte ikisini açık bırakır.
     Tanıtım metni fotoğrafın altında, düz gece zeminde. */
  .acilis {
    background: var(--color-zemin);
  }

  .acilis-gorsel {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 60vh;
    min-height: 60svh;
    overflow: hidden;
  }

  .acilis-foto {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top; /* dikey kadrajın üstünde ışıklı kirişler ve avize */
  }

  /* Tip ölçeği (1280px'te): H1 72 → alıntı 60 → H2 48 → H3 24 */
  .acilis h1 {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
  }

  .giris {
    max-width: 60ch;
    margin: 0;
    color: var(--color-krem);
    font-size: var(--text-giris);
  }

  .acilis-bant {
    background: var(--color-karartma);
  }

  .acilis-ic {
    padding-block: var(--bosluk-2) var(--bosluk-3);
  }

  /* Fotoğraf üstünde yalnızca krem metin (marka-stili §2) */
  .acilis-bant :global(.konum a),
  .acilis-bant :global(.konum li + li::before) {
    color: var(--color-krem);
  }

  .acilis h1 {
    margin-top: var(--bosluk-1);
  }

  .acilis-metin {
    padding-top: var(--bosluk-5);
  }

  /* Hikâyemiz: mobilde metin, altında fotoğraf; ≥ 1024px'te fotoğraf solda, metin sağda */
  .hikaye {
    padding-block: var(--bolum-ritim) 0;
    background: var(--color-zemin);
  }

  .hikaye-izgara {
    display: grid;
    gap: var(--bosluk-6);
  }

  .hikaye h2 {
    font-size: var(--text-h2);
  }

  .hikaye-metin p {
    max-width: var(--olcu-metin);
    margin: var(--bosluk-2) 0 0;
  }

  .hikaye-metin h2 + p {
    margin-top: var(--bosluk-3);
  }

  /* Döşenmiş, düz çekilmiş iç mekân (kemerli pod bungalov). 4:5: masaüstünde metin sütunuyla dengeli boy.
     Kadraj fotoğrafın üst %69'u ve yatayda ortadaki %74'üdür (1,36 kat, üst ortadan): avize, kemerli pencere ve
     ışık kalır; öndeki kanepenin naylonlu minderleri (fotoğraf boyunun ~%73'ünden aşağısı) kadraj dışındadır.
     Yakınlaştırma sabittir (hareket değil); sizes 1,36 katı anlatır. */
  .hikaye-foto {
    width: 100%;
    max-width: 28rem;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--radius-gorsel);
  }

  .hikaye-foto img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    transform: scale(1.36);
    transform-origin: center top;
  }

  /* Büyük alıntı: Hikâyemiz ile Vizyon/Misyon arasında ara durak; sayfanın tek iddialı tipografik öğesi.
     Tam genişlikte ara yumuşak tonlu bant; alıntı ortada, satırları dengeli kırılır. Bandın üstünde, içinde ve
     altında (Vizyonumuz'un üst boşluğu) birer ritim. */
  .alinti-blok {
    margin-top: var(--bolum-ritim);
    padding-block: var(--bolum-ritim);
    background: var(--color-zemin-ara-yumusak);
  }

  .alinti {
    max-width: 18ch;
    margin: 0 auto;
    color: var(--color-baslik);
    font-family: var(--font-baslik);
    font-size: clamp(2rem, 5vw, 3.75rem);
    font-weight: 600;
    line-height: var(--satir-baslik);
    letter-spacing: var(--aralik-baslik);
    text-align: center;
    text-wrap: balance;
  }

  /* Vizyonumuz / Misyonumuz: gece zemin; kart yok, iki açık panel. Her panelin üstünde ince ahşap çizgi.
     Mobilde alt alta, ≥ 1024px'te yan yana. */
  .degerler {
    padding-block: var(--bolum-ritim);
    background: var(--color-zemin);
  }

  .degerler-izgara {
    display: grid;
    gap: var(--bosluk-6);
  }

  .deger {
    padding-top: var(--bosluk-4);
    border-top: var(--cizgi) solid var(--color-ahsap);
  }

  .deger h2 {
    font-size: var(--text-h2);
  }

  .deger p {
    max-width: 56ch;
    margin: var(--bosluk-4) 0 0;
    font-size: var(--text-giris);
    line-height: 1.75;
  }

  /* Tam genişlik fotoğraf bandı (köşesiz) */
  .foto-bant {
    background: var(--color-zemin);
  }

  .foto-bant img {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    object-position: 40% center;
  }

  /* ≥ 768px */
  @media (min-width: 768px) {
    .hakkimizda-akis {
      --bolum-ritim: var(--bosluk-7);
    }

    .acilis-gorsel {
      min-height: 55vh;
      min-height: 55svh;
    }

    .acilis-ic {
      padding-block: var(--bosluk-3) var(--bosluk-4);
    }

    .acilis-metin {
      padding-top: var(--bosluk-6);
    }

    .foto-bant img {
      aspect-ratio: 21 / 9;
    }
  }

  /* ≥ 1024px: açılışta yatay kadraj ve daha uzun fotoğraf; hikâyede fotoğraf solda */
  @media (min-width: 1024px) {
    .acilis-foto {
      object-position: center 20%; /* tavan kirişleri ve ışıklar bandın üstünde kalır */
    }

    .acilis-gorsel {
      min-height: 70vh;
      min-height: 70svh;
    }

    .acilis-ic {
      padding-block: var(--bosluk-3) var(--bosluk-5);
    }

    .hikaye-izgara {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: var(--bosluk-8);
      align-items: center;
    }

    .hikaye-metin {
      grid-column: 2;
      grid-row: 1;
    }

    .hikaye-foto {
      grid-column: 1;
      grid-row: 1;
      max-width: none;
    }

    .degerler-izgara {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--bosluk-7);
    }

    .foto-bant img {
      aspect-ratio: 5 / 2;
    }
  }
</style>
