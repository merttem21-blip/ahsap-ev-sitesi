---
// 2K AHŞAP — ortak sayfa iskeleti
// Kurallar: .claude/skills/marka-stili ve .claude/skills/seo-kurallar
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import AltMenu from '../components/AltMenu.astro';
import { siteAdresi } from '../data/site';
import { jsonLd } from '../lib/projeler';
import { isletmeSemasi } from '../lib/sema';
import '../styles/fontlar.css';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Bağlantı önizlemesi görseli (src/lib/paylasim.ts); verilmezse logolu varsayılan görsel. */
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
  /** Sayfaya özel JSON-LD (ör. proje detayı); <head> içine yazılır. */
  sema?: Record<string, unknown>;
  /** Header hero fotoğrafının üzerinde şeffaf durur; yoksa antrasit zeminli olur. */
  seffafHeader?: boolean;
  /** Footer, yüzen buton ve mobil alt menüdeki WhatsApp linkinin hazır mesajı (sayfaya göre). */
  whatsappMesaj?: string;
  /** Header, footer ve mobil alt menüdeki "Teklif Al" linki; proje/kategori sayfalarında yapı tipini ön seçer. */
  teklifAdresi?: string;
}

const {
  title,
  description,
  image,
  imageAlt,
  noindex = false,
  sema,
  seffafHeader = false,
  whatsappMesaj,
  teklifAdresi = '/teklif-al',
} = Astro.props;
const site = Astro.site ?? new URL(siteAdresi);
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <SEO title={title} description={description} image={image} imageAlt={imageAlt} noindex={noindex} />
    <meta name="theme-color" content="#1E1E1E" />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Fontlar sitenin kendi dosyalarıdır (src/styles/fontlar.css). Gövde metninin fontu ilk boyamadan önce
         gelsin diye önceden yüklenir; Türkçe metnin büyük kısmı ve "0" (ch birimi) bu dosyadadır. -->
    <link rel="preload" href="/fonts/inter-v20-latin.woff2" as="font" type="font/woff2" crossorigin />

    <script is:inline type="application/ld+json" set:html={jsonLd(isletmeSemasi(site))} />
    {sema && <script is:inline type="application/ld+json" set:html={jsonLd(sema)} />}
  </head>

  <body>
    <a class="atla" href="#icerik">İçeriğe geç</a>

    <Header seffaf={seffafHeader} teklifAdresi={teklifAdresi} />

    <main id="icerik">
      <slot />
    </main>

    <Footer whatsappMesaj={whatsappMesaj} teklifAdresi={teklifAdresi} />
    <WhatsAppButton mesaj={whatsappMesaj} />
    <AltMenu teklifAdresi={teklifAdresi} whatsappMesaj={whatsappMesaj} />

    <script>
      import '../scripts/hareket';
    </script>
  </body>
</html>
