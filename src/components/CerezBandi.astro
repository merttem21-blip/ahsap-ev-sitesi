---
// Çerez bandı (her sayfada, Layout). Ziyaretçi seçim yapana kadar ekranın altında sabit durur; seçim localStorage'a
// yazılır ve bant bir daha gösterilmez (src/scripts/cerez.ts). JS kapalıysa hiç görünmez (hidden ile gelir).
// İki kip, src/data/site.ts → izleme:
// - Bilgilendirme (kimlikler boş): "Sitemiz izleme veya reklam çerezi kullanmaz" bilgisi ve "Anladım". Metin yalnızca
//   bu kipte doğrudur; tarayıcıdaki kayıtları /cerez-politikasi §2–3 anlatır.
// - Onay (en az bir kimlik dolu): Kabul Et ve Reddet eşit boyda ve aynı görünüşte; "Çerez ayarları" tür tür seçim
//   açar. Yalnızca kimliği girilmiş türler listelenir. Footer'daki "Çerez Tercihleri" paneli yeniden açar.
// Yerleşim: mobilde alt menünün ve Teklif Al dairesinin üstünde, alt menüyle aynı kenar payında; ≥ 768px'te sol altta,
// yüzen WhatsApp butonunun soluna kadar. Açık mobil menü paneli bandı örter. Arama sonucu özetine girmez (data-nosnippet).
// Bant açılacaksa kapladığı alt alan ilk boyamadan önce html'e --cerez-alan olarak yazılır (aşağıdaki satır içi betik)
// ve sonra değişmez; ana sayfa hero'su metnini bunun üstünde tutar (Hero.astro).
// Kısa ekranda (görünür boy < 600px) ve ana sayfa hero metnini (data-cerez-ortmesin) örtecekse bilgilendirme bandı
// sayfa kaydırılınca açılır: düğmeler ilk ekranda açıkta kalsın. Onay paneli her ekranda hemen açılır.
import { cerezOnayiGerekli, izleme } from '../data/site';
---

<section
  class="cerez"
  aria-label={cerezOnayiGerekli ? 'Çerez tercihleri' : 'Çerez bildirimi'}
  tabindex="-1"
  hidden
  data-cerez
  data-kip={cerezOnayiGerekli ? 'onay' : 'bilgi'}
  data-ga={izleme.googleAnalytics || undefined}
  data-pixel={izleme.metaPixel || undefined}
  data-nosnippet
>
  {
    cerezOnayiGerekli ? (
      <>
        <p class="cerez-metin">
          İzninizle, sitemizi geliştirmek amacıyla çerezler kullanıyoruz. Ayrıntılar için{' '}
          <a href="/cerez-politikasi">Çerez Politikası</a>'na göz atabilirsiniz.
        </p>
        <div class="cerez-ayarlar" id="cerez-ayarlar" hidden data-cerez-ayarlar>
          <ul class="cerez-turler">
            <li>
              <label class="cerez-tur">
                <input type="checkbox" checked disabled />
                <span>
                  <span class="cerez-tur-ad">Zorunlu çerezler</span>
                  <span class="cerez-tur-not">Her zaman açık</span>
                  <span class="cerez-tur-aciklama">
                    Sitenin çalışması ve çerez tercihinizin hatırlanması için gereklidir; kapatılamaz.
                  </span>
                </span>
              </label>
            </li>
            {izleme.googleAnalytics && (
              <li>
                <label class="cerez-tur">
                  <input type="checkbox" data-cerez-tur="analitik" />
                  <span>
                    <span class="cerez-tur-ad">Analitik çerezler</span>
                    <span class="cerez-tur-aciklama">
                      Sitenin nasıl kullanıldığını ölçerek sitemizi geliştirmemize yardımcı olur (Google Analytics).
                    </span>
                  </span>
                </label>
              </li>
            )}
            {izleme.metaPixel && (
              <li>
                <label class="cerez-tur">
                  <input type="checkbox" data-cerez-tur="pazarlama" />
                  <span>
                    <span class="cerez-tur-ad">Pazarlama çerezleri</span>
                    <span class="cerez-tur-aciklama">
                      Reklamlarımızı ilgilenebilecek kişilere göstermemize ve etkisini ölçmemize yardımcı olur (Meta
                      Pixel).
                    </span>
                  </span>
                </label>
              </li>
            )}
          </ul>
          <button type="button" class="dugme" data-cerez-kaydet>Seçimimi kaydet</button>
        </div>
        <div class="cerez-dugmeler">
          <div class="cerez-secim">
            <button type="button" class="dugme" data-cerez-reddet>Reddet</button>
            <button type="button" class="dugme" data-cerez-kabul>Kabul Et</button>
          </div>
          <button
            type="button"
            class="cerez-ayar-dugmesi"
            aria-expanded="false"
            aria-controls="cerez-ayarlar"
            data-cerez-ayar-dugmesi
          >
            Çerez ayarları
          </button>
        </div>
      </>
    ) : (
      <>
        {/* Mobilde (< 768px) kısa metin, masaüstünde uzun metin; görünmeyen display:none olduğu için ekran okuyucu ve
            klavye yalnızca görüneni bulur (tek link) */}
        <p class="cerez-metin">
          <span class="cerez-kisa">
            Sitemiz izleme çerezi kullanmaz. Ayrıntılar: <a href="/cerez-politikasi">Çerez Politikası</a>
          </span><span class="cerez-uzun">
            Sitemiz izleme veya reklam çerezi kullanmaz. Yalnızca sitenin çalışması için gereken bilgiler (bu
            bildirimi kapattığınız ve form taslaklarınız) tarayıcınızda tutulur. Ayrıntılar için
            <a href="/cerez-politikasi">Çerez Politikası</a>'na göz atabilirsiniz.
          </span>
        </p>
        <div class="cerez-dugmeler">
          <button type="button" class="dugme" data-cerez-tamam>Anladım</button>
        </div>
      </>
    )
  }
</section>

{
  /* İlk boyamadan önce: seçim yoksa (cerez.ts → secimVar ile aynı karar) bant bir anlığına açılıp ölçülür ve kapladığı
     alt alan --cerez-alan olarak yazılır; hero metni ilk karede bandın üstünde durur, sonradan kaymaz. Kısa ekranda
     bilgilendirme bandı ölçülmez, data-ertele alır; cerez.ts onu sayfa kaydırılınca açar. Bandı her durumda cerez.ts
     açar. Bu betik değişirse vercel.json'daki CSP'de yer alan sha256 özeti de güncellenmeli. */
}
<script is:inline>
  (function () {
    var bant = document.querySelector('[data-cerez]');
    if (!bant) return;
    var kayit = null;
    try {
      kayit = JSON.parse(localStorage.getItem('2k-ahsap-cerez-tercihi') || 'null');
    } catch (e) {}
    if (!kayit || typeof kayit.zaman !== 'number') kayit = null;
    var turler = [];
    if (bant.dataset.ga) turler.push('analitik');
    if (bant.dataset.pixel) turler.push('pazarlama');
    var secimVar = turler.length
      ? turler.every(function (t) {
          return kayit && typeof kayit[t] === 'boolean';
        })
      : !!kayit;
    if (secimVar) return;
    if (bant.dataset.kip === 'bilgi' && innerHeight < 600) {
      bant.setAttribute('data-ertele', '');
      return;
    }
    bant.hidden = false;
    var alan = Math.ceil(innerHeight - bant.getBoundingClientRect().top);
    bant.hidden = true;
    document.documentElement.style.setProperty('--cerez-alan', alan + 'px');
  })();
</script>

<script>
  import { cerezBandi } from '../scripts/cerez';

  cerezBandi();
</script>

<style>
  /* Mobil (< 768px): alt menüyle aynı kenar payında, Teklif Al dairesinin (barın 16px üstüne taşar) üstünde */
  .cerez {
    position: fixed;
    right: var(--alt-menu-pay);
    bottom: calc(var(--alt-menu-alan) + var(--bosluk-2));
    left: var(--alt-menu-pay);
    z-index: var(--z-cerez);
    display: flex;
    flex-direction: column;
    gap: var(--bosluk-2);
    max-height: calc(100vh - var(--alt-menu-alan) - var(--bosluk-4));
    max-height: calc(100svh - var(--alt-menu-alan) - var(--bosluk-4));
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: var(--bosluk-2);
    border: var(--cizgi) solid var(--color-cizgi-menu);
    border-radius: var(--radius-kart);
    background: var(--color-antrasit);
    color: var(--color-metin);
    font-size: var(--text-kucuk);
    line-height: 1.6;
  }

  .cerez-metin {
    max-width: var(--olcu-metin);
    margin: 0;
  }

  .cerez-metin a {
    color: var(--color-krem);
    text-underline-offset: 3px;
  }

  .cerez-metin a:hover {
    color: var(--color-ahsap-acik);
  }

  .cerez-dugmeler {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
  }

  /* Kabul Et ve Reddet: aynı genişlik ve aynı görünüş; sığmazsa (320px) alt alta, yine tam ve eşit genişlikte */
  .cerez-secim {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 9rem), 1fr));
    gap: 12px;
    width: 100%;
  }

  .cerez-ayar-dugmesi {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-krem);
    font: inherit;
    font-weight: 500;
    text-decoration: underline;
    text-decoration-color: var(--color-ahsap);
    text-underline-offset: 4px;
    cursor: pointer;
  }

  .cerez-ayar-dugmesi:hover {
    color: var(--color-ahsap-acik);
  }

  /* Çerez ayarları: tür başına bir satır, ince çizgiyle ayrılır */
  .cerez-ayarlar {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--bosluk-2);
  }

  .cerez-turler {
    width: 100%;
    border-bottom: var(--cizgi) solid var(--color-cizgi);
  }

  .cerez-tur {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding-block: 12px;
    border-top: var(--cizgi) solid var(--color-cizgi);
    cursor: pointer;
  }

  .cerez-tur input {
    width: 22px;
    height: 22px;
    margin: 0;
    flex-shrink: 0;
    accent-color: var(--color-krem);
    cursor: pointer;
  }

  .cerez-tur:has(input:disabled),
  .cerez-tur input:disabled {
    cursor: default;
  }

  .cerez-tur-ad {
    color: var(--color-baslik);
    font-weight: 500;
  }

  .cerez-tur-not {
    margin-left: var(--bosluk-1);
    color: var(--color-ahsap-acik);
  }

  .cerez-tur-aciklama {
    display: block;
    color: var(--color-metin-soluk);
  }

  /* Bilgilendirme bandı, mobil (< 768px): kısa metin ve sağında küçük "Anladım" tek satırda, iç boşluk 12px
     (375px'te bant ~87px). Metne 10rem kalmazsa (320px) düğme metnin altına geçer. Düğmenin dokunma alanı 44px. */
  .cerez[data-kip='bilgi'] {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--bosluk-1) 12px;
    padding: 12px;
  }

  .cerez[data-kip='bilgi'] .cerez-metin {
    flex: 1 1 10rem;
    min-width: 0;
    line-height: 1.45;
  }

  .cerez-uzun {
    display: none;
  }

  .cerez[data-kip='bilgi'] .cerez-dugmeler {
    flex-shrink: 0;
  }

  .cerez[data-kip='bilgi'] .dugme {
    min-height: 44px;
    gap: var(--bosluk-1);
    padding: 0 14px 0 var(--bosluk-2);
    font-size: var(--text-kucuk);
  }

  .cerez[data-kip='bilgi'] .dugme::after {
    width: 16px;
    height: 16px;
  }

  /* Işık kutusu açıkken ve mobilde formda yazarken (ekran klavyesi) bant gizlenir; alt menüyle aynı kural */
  :global(html.kaydirma-kilitli) .cerez,
  :global(body:has(:is(input:not([type='checkbox'], [type='radio']), textarea, select):focus)) .cerez {
    display: none;
  }

  /* ≥ 640px: onay panelinde Kabul/Reddet solda, ayarlar sağda */
  @media (min-width: 640px) {
    .cerez[data-kip='onay'] .cerez-dugmeler {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 12px var(--bosluk-3);
    }

    .cerez-secim {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      width: auto;
    }
  }

  /* ≥ 768px: mobil alt menü yok. Sol altta; sağda yüzen WhatsApp butonuna (56px, kenardan 16px) yer kalır.
     Formda yazarken gizlenmez (ekran klavyesi yok). */
  @media (min-width: 768px) {
    .cerez {
      right: calc(var(--bosluk-2) * 2 + 56px);
      bottom: var(--bosluk-2);
      left: var(--bosluk-2);
      max-width: 560px;
      max-height: calc(100vh - var(--bosluk-4));
      max-height: calc(100svh - var(--bosluk-4));
      padding: var(--bosluk-3);
    }

    /* Bilgilendirme bandı: uzun metin solda, sitenin standart "Anladım" düğmesi sağda */
    .cerez[data-kip='bilgi'] {
      flex-wrap: nowrap;
      gap: var(--bosluk-3);
      padding: var(--bosluk-3);
    }

    .cerez[data-kip='bilgi'] .cerez-metin {
      flex: 1;
      line-height: inherit;
    }

    .cerez-kisa {
      display: none;
    }

    .cerez-uzun {
      display: inline;
    }

    .cerez[data-kip='bilgi'] .dugme {
      min-height: 48px;
      gap: 12px;
      padding: 12px 28px 12px 32px;
      font-size: var(--text-dugme);
    }

    .cerez[data-kip='bilgi'] .dugme::after {
      width: 18px;
      height: 18px;
    }

    :global(body:has(:is(input:not([type='checkbox'], [type='radio']), textarea, select):focus)) .cerez {
      display: flex;
    }
  }

  @media print {
    .cerez {
      display: none !important;
    }
  }
</style>
