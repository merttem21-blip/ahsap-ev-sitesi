---
// Sayfa meta etiketleri: canonical, Open Graph ve Twitter kartı. Kurallar: .claude/skills/seo-kurallar
import { firma, siteAdresi } from '../data/site';
import { PAYLASIM_GENISLIK, PAYLASIM_YUKSEKLIK, varsayilanPaylasim } from '../lib/paylasim';

interface Props {
  title: string; // en fazla 60 karakter, "| 2K AHŞAP" dahil
  description: string; // 120–155 karakter
  image?: string; // bağlantı önizlemesi görseli: /paylasim/….jpg (1200×630, src/lib/paylasim.ts)
  imageAlt?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  image = varsayilanPaylasim.yol,
  imageAlt = varsayilanPaylasim.alt,
  noindex = false,
} = Astro.props;
const site = Astro.site ?? new URL(siteAdresi);
const yol = Astro.url.pathname.replace(/\/$/, '') || '/';
const canonical = new URL(yol, site).href;
const ogGorsel = new URL(image, site).href;

if (import.meta.env.DEV) {
  if (title.length > 60) console.warn(`[SEO] Başlık ${title.length} karakter: ${yol}`);
  if (description.length < 120 || description.length > 155)
    console.warn(`[SEO] Açıklama ${description.length} karakter: ${yol}`);
}
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex" />}

<meta property="og:type" content="website" />
<meta property="og:locale" content="tr_TR" />
<meta property="og:site_name" content={firma.marka} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogGorsel} />
<meta property="og:image:type" content="image/jpeg" />
<meta property="og:image:width" content={String(PAYLASIM_GENISLIK)} />
<meta property="og:image:height" content={String(PAYLASIM_YUKSEKLIK)} />
<meta property="og:image:alt" content={imageAlt} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogGorsel} />
<meta name="twitter:image:alt" content={imageAlt} />
