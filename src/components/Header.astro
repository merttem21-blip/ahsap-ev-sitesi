---
// Site üst bölümü: logo solda, ana menü sağda; mobilde tam ekran menü paneli.
// Header her yerde koyudur; plakasız koyu zemin SVG logosu kullanılır (marka-stili §4, §8).
import { kategoriler, menu } from '../data/site';
import { ikon } from '../data/ikonlar';

interface Props {
  /** Ana sayfa: hero fotoğrafının üzerinde şeffaf durur ve logo büyük gösterilir.
      Diğer sayfalarda antrasit zemin ve standart logo boyutu. */
  seffaf?: boolean;
}

const { seffaf = false } = Astro.props;

const yol = Astro.url.pathname.replace(/\/$/, '') || '/';
// Kategori ve proje sayfaları (/bungalov, /bungalov/proje) "Projeler" menüsüne aittir
const projeSayfasi = kategoriler.some((k) => yol === `/${k.slug}` || yol.startsWith(`/${k.slug}/`));
const aktifMi = (href: string) =>
  href === '/'
    ? yol === '/'
    : yol === href || yol.startsWith(`${href}/`) || (href === '/projeler' && projeSayfasi);
---

<header class:list={['ust', { 'ust-seffaf': seffaf }]} data-ust>
  <div class="kap ust-ic">
    <a href="/" class="logo" aria-label="2K AHŞAP ana sayfa">
      <img
        src="/logo/2k-ahsap-logo-koyu-zemin.svg"
        width="560"
        height="500"
        alt="2K AHŞAP"
        loading="eager"
      />
    </a>

    <button
      class="menu-dugme"
      type="button"
      aria-expanded="false"
      aria-controls="ana-menu"
      data-menu-dugme
    >
      <span class="gizli" data-menu-etiket>Menüyü aç</span>
      <svg class="ikon ikon-menu" viewBox="0 0 24 24" aria-hidden="true" set:html={ikon.menu} />
      <svg class="ikon ikon-kapat" viewBox="0 0 24 24" aria-hidden="true" set:html={ikon.kapat} />
    </button>

    <nav id="ana-menu" class="menu" aria-label="Ana menü">
      <ul>
        {
          menu.map((m) => (
            <li>
              <a href={m.href} aria-current={aktifMi(m.href) ? 'page' : undefined}>
                <span>{m.ad}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <a href="/iletisim" class="dugme menu-cta">Teklif Al</a>
    </nav>
  </div>
</header>

<script>
  const ust = document.querySelector<HTMLElement>('[data-ust]');
  const dugme = document.querySelector<HTMLButtonElement>('[data-menu-dugme]');
  const etiket = document.querySelector<HTMLElement>('[data-menu-etiket]');
  const menu = document.getElementById('ana-menu');
  const masaustu = window.matchMedia('(min-width: 1024px)');

  const acikMi = () => dugme?.getAttribute('aria-expanded') === 'true';

  const ayarla = (acik: boolean) => {
    dugme?.setAttribute('aria-expanded', String(acik));
    menu?.classList.toggle('acik', acik);
    // Panel açıkken arkadaki sayfa kaymaz
    document.documentElement.classList.toggle('menu-acik', acik);
    if (etiket) etiket.textContent = acik ? 'Menüyü kapat' : 'Menüyü aç';
  };

  dugme?.addEventListener('click', () => ayarla(!acikMi()));

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && acikMi()) {
      ayarla(false);
      dugme?.focus();
    }
  });

  // Tab ile menünün dışına çıkılınca veya dışarı tıklanınca kapanır
  ust?.addEventListener('focusout', (e) => {
    const hedef = e.relatedTarget as Node | null;
    if (acikMi() && hedef && !ust.contains(hedef)) ayarla(false);
  });

  document.addEventListener('click', (e) => {
    if (acikMi() && !ust?.contains(e.target as Node)) ayarla(false);
  });

  // Masaüstü genişliğine geçilirse panel kapanır (menü satır içinde gösterilir)
  masaustu.addEventListener('change', (e) => {
    if (e.matches && acikMi()) ayarla(false);
  });
</script>

<style>
  .ust {
    position: relative;
    z-index: var(--z-header);
    border-bottom: var(--cizgi) solid var(--color-cizgi);
    background: var(--color-zemin-ara);
    color: var(--color-krem);
  }

  /* Ana sayfa: hero fotoğrafının üzerinde şeffaf */
  .ust-seffaf {
    position: absolute;
    inset: 0 0 auto;
    border-bottom-color: transparent;
    background: transparent;
  }

  /* Menü metninin altında fotoğraf ne kadar açık olursa olsun ≥ %70 karartma (marka-stili §2);
     header'ın alt kenarına doğru şeffaflaşır. */
  .ust-seffaf::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, var(--color-karartma) 0%, var(--color-karartma) 55%, transparent 100%);
    pointer-events: none;
  }

  .ust-ic {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--bosluk-3);
    padding-block: var(--bosluk-2);
  }

  /* Logo ve menü düğmesi açık panelin üzerinde kalır */
  .logo,
  .menu-dugme {
    position: relative;
    z-index: 1;
  }

  /* Çevresinde logo yüksekliğinin en az %25'i kadar boşluk (marka-stili §4) */
  .logo {
    display: block;
    flex-shrink: 0;
  }

  .logo img {
    width: auto;
    height: 56px;
  }

  .ust-seffaf .logo img {
    height: 72px;
  }

  .menu-dugme {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    margin-right: -12px;
    border: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
  }

  .menu-dugme .ikon {
    width: 28px;
    height: 28px;
  }

  .menu-dugme .ikon-kapat,
  .menu-dugme[aria-expanded='true'] .ikon-menu {
    display: none;
  }

  .menu-dugme[aria-expanded='true'] .ikon-kapat {
    display: block;
  }

  /* Mobil: tam ekran koyu panel */
  .menu {
    position: fixed;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--bosluk-5);
    padding: 128px var(--bosluk-2) var(--bosluk-5);
    overflow-y: auto;
    background: var(--color-zemin);
    visibility: hidden;
    opacity: 0;
    transform: translateY(-8px);
    transition:
      opacity var(--gecis),
      transform var(--gecis),
      visibility var(--sure-kisa);
  }

  .menu.acik {
    visibility: visible;
    opacity: 1;
    transform: none;
  }

  .menu ul {
    border-top: var(--cizgi) solid var(--color-cizgi);
  }

  .menu a:not(.dugme) {
    display: flex;
    align-items: center;
    min-height: 72px;
    border-bottom: var(--cizgi) solid var(--color-cizgi);
    color: var(--color-metin);
    font-family: var(--font-baslik);
    font-size: var(--text-h2);
    font-weight: 600;
    letter-spacing: var(--aralik-baslik);
    line-height: var(--satir-baslik);
    text-decoration: none;
  }

  .menu a:not(.dugme):hover,
  .menu a[aria-current='page'] {
    color: var(--color-krem);
  }

  /* Alt çizgi: hover'da soldan sağa uzar (ahşap); aktif sayfada ince yeşil çizgi sabit durur */
  .menu a span {
    position: relative;
  }

  .menu a span::after {
    content: '';
    position: absolute;
    inset: auto 0 -8px;
    height: var(--cizgi);
    background: var(--color-ahsap);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--sure) var(--ease-out);
  }

  .menu a:hover span::after {
    transform: scaleX(1);
  }

  .menu a[aria-current='page'] span::after {
    height: 2px;
    background: var(--color-yesil);
    transform: scaleX(1);
  }

  .menu-cta {
    width: 100%;
  }

  :global(html.menu-acik) {
    overflow: hidden;
  }

  :global(html.menu-acik) .ust {
    z-index: var(--z-menu);
  }

  /* ≥ 768px */
  @media (min-width: 768px) {
    .menu {
      padding-inline: var(--bosluk-3);
    }
  }

  /* ≥ 1024px: menü satır içinde, sağa yaslı */
  @media (min-width: 1024px) {
    .ust-ic {
      padding-block: 20px;
    }

    .ust-seffaf .ust-ic {
      padding-block: var(--bosluk-3);
    }

    .logo img {
      height: 72px;
    }

    .ust-seffaf .logo img {
      height: 100px;
    }

    .menu-dugme {
      display: none;
    }

    .menu {
      position: static;
      flex-direction: row;
      align-items: center;
      gap: var(--bosluk-5);
      padding: 0;
      overflow: visible;
      background: none;
      visibility: visible;
      opacity: 1;
      transform: none;
      transition: none;
    }

    .menu ul {
      display: flex;
      gap: var(--bosluk-4);
      border-top: 0;
    }

    .menu a:not(.dugme) {
      min-height: 44px;
      border-bottom: 0;
      font-family: var(--font-metin);
      font-size: var(--text-kucuk);
      font-weight: 500;
      letter-spacing: var(--aralik-etiket);
      line-height: 1.2;
      text-transform: uppercase;
      white-space: nowrap;
    }

    /* Büyük harf aralığı son harften sonra da boşluk bırakır; çizgi metinle aynı yerde biter */
    .menu a span::after {
      inset: auto var(--aralik-etiket) -6px 0;
    }

    .menu-cta {
      width: auto;
      min-height: 44px;
      padding-block: 10px;
    }
  }
</style>
