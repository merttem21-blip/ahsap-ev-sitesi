---
// Site üst bölümü: logo solda, ana menü sağda; mobilde tam ekran menü paneli.
// Header her yerde koyudur; plakasız koyu zemin SVG logosu kullanılır (marka-stili §4, §8).
// Sayfa kaydırılınca üstte sabit kalır ve küçülür. Küçülme yalnızca transform/opacity ile yapılır:
// header'ın kapladığı yer değişmez, layout kayması olmaz.
import { firma, menu, menuAktifMi } from '../data/site';
import { ikon } from '../data/ikonlar';

interface Props {
  /** Ana sayfa: hero fotoğrafının üzerinde şeffaf durur ve logo büyük gösterilir.
      Diğer sayfalarda antrasit zemin ve standart logo boyutu. */
  seffaf?: boolean;
  /** "Teklif Al" linki; proje ve kategori sayfalarında yapı tipini ön seçer */
  teklifAdresi?: string;
}

const { seffaf = false, teklifAdresi = '/teklif-al' } = Astro.props;

const yol = Astro.url.pathname.replace(/\/$/, '') || '/';
const aktifMi = (href: string) => menuAktifMi(yol, href);
---

<header class:list={['ust', { 'ust-seffaf': seffaf }]} data-ust>
  <div class="kap ust-ic">
    <a href="/" class="logo" aria-label={`${firma.marka} ana sayfa`}>
      <img
        src="/logo/2k-ahsap-logo-koyu-zemin.svg"
        width="560"
        height="500"
        alt={firma.marka}
        loading="eager"
      />
    </a>

    <button
      class="menu-dugme"
      type="button"
      aria-expanded="false"
      aria-controls="ana-menu"
      data-menu-dugme
    >
      <span class="gizli" data-menu-etiket>Menüyü aç</span>
      <svg class="ikon ikon-menu" viewBox="0 0 24 24" aria-hidden="true" set:html={ikon.menu} />
      <svg class="ikon ikon-kapat" viewBox="0 0 24 24" aria-hidden="true" set:html={ikon.kapat} />
    </button>

    <nav id="ana-menu" class="menu" aria-label="Ana menü">
      <ul>
        {
          menu.map((m) => (
            <li>
              <a href={m.href} class="dokunma-genislik" aria-current={aktifMi(m.href) ? 'page' : undefined}>
                <span>{m.ad}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <a href={teklifAdresi} class="dugme menu-cta">Teklif Al</a>
    </nav>
  </div>
</header>

<script>
  // Menü paneli iki düğmeyle açılır: header'daki (768px ve üstü) ve mobil alt menüdeki "Menü" (AltMenu.astro).
  // aria-expanded ikisinde de aynı tutulur.
  //
  // Klavye ve ekran okuyucu: panel açıkken header ve mobil alt menü dışındaki her şey (sayfa içeriği, footer,
  // yüzen buton) inert olur; panel onları zaten örttüğü için görünüm ve dokunma davranışı değişmez. Tab, header ile
  // alt menü arasında döner, sayfanın arkasına geçmez. Panel bağlantılarında Aşağı/Yukarı oklar, Home ve End ile
  // gezilir. Esc paneli kapatır ve odak paneli açan düğmeye döner.
  import { odagiTut, odaklanabilirler, oklarlaGez } from '../scripts/odak';

  const ust = document.querySelector<HTMLElement>('[data-ust]');
  const dugmeler = [...document.querySelectorAll<HTMLButtonElement>('[data-menu-dugme]')];
  const etiket = document.querySelector<HTMLElement>('[data-menu-etiket]');
  const menu = document.getElementById('ana-menu');
  const altMenu = dugmeler.find((d) => !ust?.contains(d))?.closest('nav') ?? null;
  const masaustu = window.matchMedia('(min-width: 1024px)');
  let acanDugme: HTMLButtonElement | null = null;

  const acikMi = () => menu?.classList.contains('acik') ?? false;
  // Header ve menü düğmeleri menünün parçası sayılır: aralarında gezinmek menüyü kapatmaz
  const menudeMi = (dugum: Node | null) =>
    !!dugum && (!!ust?.contains(dugum) || dugmeler.some((d) => d.contains(dugum)));
  // Klavye odağı için panelle birlikte görünen mobil alt menü de menünün parçasıdır
  const odakAlanindaMi = (dugum: Node | null) => menudeMi(dugum) || (!!dugum && !!altMenu?.contains(dugum));
  const odakAlani = () => odaklanabilirler(ust, altMenu);

  // Panelin arkasında kalan, header ve alt menü dışındaki sayfa öğeleri
  const arkaPlan = () =>
    [...document.body.children].filter(
      (e): e is HTMLElement => e instanceof HTMLElement && e !== ust && e !== altMenu && e.tagName !== 'SCRIPT'
    );

  const ayarla = (acik: boolean) => {
    for (const d of dugmeler) d.setAttribute('aria-expanded', String(acik));
    // Panel her açılışta en üstten başlar
    if (acik && menu) menu.scrollTop = 0;
    menu?.classList.toggle('acik', acik);
    // Panel açıkken arkadaki sayfa kaymaz
    document.documentElement.classList.toggle('menu-acik', acik);
    for (const e of arkaPlan()) e.inert = acik;
    if (etiket) etiket.textContent = acik ? 'Menüyü kapat' : 'Menüyü aç';
  };

  for (const d of dugmeler) {
    d.addEventListener('click', (e) => {
      const acilacak = !acikMi();
      acanDugme = d;
      ayarla(acilacak);
      // Alt menüden klavyeyle (Enter/Boşluk: detail 0) açılınca odak panele geçer; panel DOM'da düğmeden önce durur.
      // Dokunma ve farede odak düğmede kalır (görünüm değişmez). Panel visibility geçişinin ilk anında henüz gizli
      // sayılır ve odak alamaz; odak, panelin görünür olduğu ilk karede verilir.
      const ilk = menu?.querySelector<HTMLElement>('a');
      if (acilacak && ilk && !ust?.contains(d) && e.detail === 0) {
        let kare = 0;
        const odakla = () => {
          if (!acikMi()) return;
          ilk.focus();
          if (document.activeElement !== ilk && ++kare < 30) requestAnimationFrame(odakla);
        };
        odakla();
      }
    });
  }

  document.addEventListener('keydown', (e) => {
    if (!acikMi()) return;
    if (e.key === 'Escape') {
      ayarla(false);
      acanDugme?.focus();
      return;
    }
    if (e.key === 'Tab') odagiTut(e, odakAlani());
    if (menu?.contains(document.activeElement)) oklarlaGez(e, odaklanabilirler(menu));
  });

  // Odak header ve alt menünün dışına çıkarsa (ör. ekran okuyucuyla) veya dışarı tıklanınca kapanır
  for (const alan of [ust, altMenu]) {
    alan?.addEventListener('focusout', (e) => {
      const hedef = e.relatedTarget as Node | null;
      if (acikMi() && hedef && !odakAlanindaMi(hedef)) ayarla(false);
    });
  }

  document.addEventListener('click', (e) => {
    if (acikMi() && !menudeMi(e.target as Node)) ayarla(false);
  });

  // Masaüstü genişliğine geçilirse panel kapanır (menü satır içinde gösterilir)
  masaustu.addEventListener('change', (e) => {
    if (e.matches && acikMi()) ayarla(false);
  });

  // Kaydırınca küçülme: kare başına en fazla bir kontrol (rAF), pasif dinleyici
  const ESIK = 40;
  let bekliyor = false;
  const kucult = () => {
    bekliyor = false;
    ust?.classList.toggle('ust-kucuk', window.scrollY > ESIK);
  };
  window.addEventListener(
    'scroll',
    () => {
      if (bekliyor) return;
      bekliyor = true;
      requestAnimationFrame(kucult);
    },
    { passive: true }
  );
  kucult();
</script>

<style>
  /* Ölçüler: --logo ve --pay üst durum, --logo-kucuk ve --pay-kucuk kaydırılmış durum.
     --olcek = --logo-kucuk / --logo (CSS uzunluk bölmesi her tarayıcıda desteklenmediği için elle). */
  .ust {
    --logo: 64px;
    --pay: 12px;
    --logo-kucuk: 64px;
    --pay-kucuk: 12px;
    --olcek: 1;
    --h: calc(var(--logo) + 2 * var(--pay));
    --h-kucuk: calc(var(--logo-kucuk) + 2 * var(--pay-kucuk));

    position: sticky;
    top: 0;
    z-index: var(--z-header);
    color: var(--color-krem);
    transition: transform var(--sure) var(--ease-out);
  }

  /* Ana sayfa: hero fotoğrafının üzerinde şeffaf ve sabit; logo büyük */
  .ust-seffaf {
    --logo: 90px;
    --pay: 16px;
    --olcek: 0.7111; /* 64 / 90 */
    position: fixed;
    inset: 0 0 auto;
  }

  /* Zemin katmanları: üst durum (::before) ve kaydırılmış durum (::after) opacity ile değişir */
  .ust::before,
  .ust::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    transition: opacity var(--sure) var(--ease-out);
  }

  .ust::before {
    border-bottom: var(--cizgi) solid var(--color-cizgi);
    background: var(--color-zemin-ara);
  }

  /* Menü metninin altında fotoğraf ne kadar açık olursa olsun ≥ %70 karartma (marka-stili §2);
     header'ın alt kenarına doğru şeffaflaşır. */
  /* Kenarlık yok: şeffaf kenarlık alanında gradyan tekrarlanır ve 1px koyu çizgi çizer */
  .ust-seffaf::before {
    border-bottom: 0;
    background: linear-gradient(180deg, var(--color-karartma) 0%, var(--color-karartma) 55%, transparent 100%);
  }

  .ust::after {
    border-bottom: var(--cizgi) solid var(--color-cizgi);
    background: var(--color-ust-kucuk);
    opacity: 0;
  }

  /* Kaydırılmış durum: header yukarı kayar, yalnızca alttaki --h-kucuk kadarı görünür;
     içerik bu dar şeridin ortasına iner, logo ölçeklenir. */
  .ust-kucuk {
    transform: translateY(calc(var(--h-kucuk) - var(--h)));
  }

  .ust-kucuk::before {
    opacity: 0;
  }

  .ust-kucuk::after {
    opacity: 1;
  }

  .ust-ic {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--bosluk-3);
    padding-block: var(--pay);
    transition: transform var(--sure) var(--ease-out);
  }

  .ust-kucuk .ust-ic {
    transform: translateY(calc((var(--h) - var(--h-kucuk)) / 2));
  }

  /* Kaydırılmış durumda .ust-ic ve logo linkinin kutusu header'ın görünen alt kenarının altına taşar (ana sayfada
     17 / 50 px, diğer sayfalarda ≥ 1024px'te 12 px). Taşan boş kısım altındaki sayfanın tıklamasını yutmasın:
     tıklamayı yalnızca görünen öğeler alır (menü, düğmeler, ölçeklenmiş logo görseli). */
  .ust-kucuk .ust-ic {
    pointer-events: none;
  }

  .ust-kucuk .ust-ic > * {
    pointer-events: auto;
  }

  .ust-kucuk .ust-ic > .logo {
    pointer-events: none;
  }

  .ust-kucuk .logo img {
    pointer-events: auto;
  }

  /* Logo ve menü düğmesi açık panelin üzerinde kalır */
  .logo,
  .menu-dugme {
    position: relative;
    z-index: 1;
  }

  /* Çevresinde logo yüksekliğinin en az %25'i kadar boşluk (marka-stili §4) */
  .logo {
    display: block;
    flex-shrink: 0;
  }

  /* will-change: logo kendi katmanında bir kez boyanır; küçülürken yeniden boyanmaz
     (SVG'deki döndürülmüş ahşap desenleri her yeniden boyamada çok pahalıdır) */
  .logo img {
    width: auto;
    height: var(--logo);
    transform-origin: left center;
    transition: transform var(--sure) var(--ease-out);
    will-change: transform;
  }

  .ust-kucuk .logo img {
    transform: scale(var(--olcek));
  }

  /* Açık mobil menü tam ekran sabit paneldir; dönüşümlü bir üst öğe onu header'a hapseder.
     Panel açıkken header üst durumuna döner (panel her şeyi örttüğü için görünmez).
     Kaydırılmış durumun kuralları (.ust-kucuk .ust-ic, .ust-kucuk .logo img) daha özgül olduğu için ayrıca
     sıfırlanır: yoksa translateY(0) bile paneli header'ın kutusuna hapseder, panel kesilir ve kaymaz. */
  :global(html.menu-acik) .ust,
  :global(html.menu-acik) .ust-ic,
  :global(html.menu-acik) .logo img,
  :global(html.menu-acik) .ust-kucuk .ust-ic,
  :global(html.menu-acik) .ust-kucuk .logo img {
    transform: none;
    transition: none;
  }

  :global(html.menu-acik) .ust {
    z-index: var(--z-menu);
  }

  /* < 768px: gizli; paneli mobil alt menüdeki "Menü" düğmesi açar (AltMenu.astro) */
  .menu-dugme {
    display: none;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    margin-right: -12px;
    border: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
  }

  .menu-dugme .ikon {
    width: 28px;
    height: 28px;
  }

  .menu-dugme .ikon-kapat,
  .menu-dugme[aria-expanded='true'] .ikon-menu {
    display: none;
  }

  .menu-dugme[aria-expanded='true'] .ikon-kapat {
    display: block;
  }

  /* Mobilde panelin altı yüzen alt menünün (ve iPhone'un alt güvenli alanının) altında kalmaz */
  .menu {
    --alt-serit: var(--alt-menu-alan);
    --alt-pay: var(--bosluk-2);
  }

  /* Mobil: tam ekran koyu panel. Sığmazsa kendi içinde kayar; kaydırma arkadaki sayfaya taşmaz.
     Üstteki logo şeridi ve alttaki alt menü şeridi dolgu değil, zeminle aynı renkte kenarlıktır: kaydırma alanı
     ikisinin arasında kalır, kayan bağlantılar logonun ve alt menünün altından geçmez. */
  .menu {
    position: fixed;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--bosluk-5);
    padding: var(--bosluk-2) var(--bosluk-2) var(--alt-pay);
    border-style: solid;
    border-color: var(--color-zemin);
    border-width: var(--h) 0 var(--alt-serit);
    overflow-y: auto;
    overscroll-behavior: contain;
    background: var(--color-zemin);
    visibility: hidden;
    opacity: 0;
    transform: translateY(-8px);
    transition:
      opacity var(--gecis),
      transform var(--gecis),
      visibility var(--sure-kisa);
  }

  .menu.acik {
    visibility: visible;
    opacity: 1;
    transform: none;
  }

  .menu ul {
    border-top: var(--cizgi) solid var(--color-cizgi);
  }

  .menu a:not(.dugme) {
    display: flex;
    align-items: center;
    min-height: 72px;
    border-bottom: var(--cizgi) solid var(--color-cizgi);
    color: var(--color-metin);
    font-family: var(--font-baslik);
    font-size: var(--text-h2);
    font-weight: 600;
    letter-spacing: var(--aralik-baslik);
    line-height: var(--satir-baslik);
    text-decoration: none;
  }

  .menu a:not(.dugme):hover,
  .menu a[aria-current='page'] {
    color: var(--color-krem);
  }

  /* Alt çizgi: hover'da soldan sağa uzar (ahşap); aktif sayfada ince yeşil çizgi sabit durur */
  .menu a span {
    position: relative;
  }

  .menu a span::after {
    content: '';
    position: absolute;
    inset: auto 0 -8px;
    height: var(--cizgi);
    background: var(--color-ahsap);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--sure) var(--ease-out);
  }

  .menu a:hover span::after {
    transform: scaleX(1);
  }

  .menu a[aria-current='page'] span::after {
    height: 2px;
    background: var(--color-yesil);
    transform: scaleX(1);
  }

  .menu-cta {
    width: 100%;
  }

  :global(html.menu-acik) {
    overflow: hidden;
  }

  /* ≥ 768px: alt menü yok; panel header'daki düğmeyle açılır */
  @media (min-width: 768px) {
    .menu-dugme {
      display: inline-flex;
    }

    .menu {
      --alt-serit: 0px;
      --alt-pay: var(--bosluk-5);
      padding-inline: var(--bosluk-3);
    }
  }

  /* ≥ 1024px: menü satır içinde, sağa yaslı */
  @media (min-width: 1024px) {
    .ust {
      --logo: 72px;
      --pay: 20px;
      --olcek: 0.8889; /* 64 / 72 */
    }

    .ust-seffaf {
      --logo: 140px;
      --pay: 24px;
      --olcek: 0.4571; /* 64 / 140 */
    }

    /* Küçülme katmanları baştan hazır: ilk kaydırmada katman oluşturma takılması olmaz.
       Mobilde verilmez; dönüşüm ipucu sabit menü panelini header'a hapseder. */
    .ust,
    .ust-ic {
      will-change: transform;
    }

    .ust::before,
    .ust::after {
      will-change: opacity;
    }

    .menu-dugme {
      display: none;
    }

    .menu {
      position: static;
      flex-direction: row;
      align-items: center;
      gap: var(--bosluk-5);
      padding: 0;
      border: 0;
      overflow: visible;
      background: none;
      visibility: visible;
      opacity: 1;
      transform: none;
      transition: none;
    }

    /* 1024–1279px'te aralık dar tutulur: altı link ve CTA logoyla birlikte tek satıra sığar */
    .menu ul {
      display: flex;
      gap: var(--bosluk-3);
      border-top: 0;
    }

    .menu a:not(.dugme) {
      min-height: 44px;
      border-bottom: 0;
      font-family: var(--font-metin);
      font-size: var(--text-kucuk);
      font-weight: 500;
      letter-spacing: var(--aralik-etiket);
      line-height: 1.2;
      text-transform: uppercase;
      white-space: nowrap;
    }

    /* Büyük harf aralığı son harften sonra da boşluk bırakır; çizgi metinle aynı yerde biter */
    .menu a span::after {
      inset: auto var(--aralik-etiket) -6px 0;
    }

    .menu-cta {
      width: auto;
      min-height: 44px;
      padding-block: 10px;
    }
  }

  /* ≥ 1280px */
  @media (min-width: 1280px) {
    .menu ul {
      gap: var(--bosluk-4);
    }
  }
</style>
