---
// Henüz hazırlanmamış sayfalar için geçici içerik. Sayfa hazır olunca kaldırılır.
import { firma, whatsappLinki } from '../data/site';

interface Props {
  baslik: string; // sayfanın tek H1'i
  metin: string;
  whatsapp?: string; // sayfaya göre hazır mesajlı WhatsApp linki
}

const { baslik, metin, whatsapp = whatsappLinki() } = Astro.props;
---

<section class="yakinda" aria-labelledby="yakinda-baslik">
  <div class="kap">
    <p class="yakinda-etiket">Yakında</p>
    <h1 id="yakinda-baslik">{baslik}</h1>
    <p class="yakinda-metin">{metin}</p>
    <div class="yakinda-eylemler">
      <a href={firma.telefonLink} class="dugme dugme-birincil">Bizi arayın: {firma.telefonGorunen}</a>
      <a href={whatsapp} class="yakinda-link" target="_blank" rel="noopener noreferrer">WhatsApp'tan yazın</a>
      <a href={`mailto:${firma.eposta}`} class="yakinda-link">{firma.eposta}</a>
    </div>
  </div>
</section>

<style>
  .yakinda {
    display: flex;
    align-items: center;
    min-height: 60vh;
    min-height: 60svh;
    padding-block: 64px;
    background: var(--color-zemin);
  }

  .yakinda-etiket {
    margin: 0 0 8px;
    color: var(--color-ahsap-acik);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .yakinda h1 {
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 700;
  }

  .yakinda-metin {
    max-width: 60ch;
    margin: 16px 0 32px;
  }

  .yakinda-eylemler {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 24px;
  }

  .yakinda-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 500;
    text-decoration: underline;
  }

  .yakinda-link:hover {
    color: var(--color-ahsap-acik);
  }

  @media (min-width: 768px) {
    .yakinda {
      padding-block: 96px;
    }
  }
</style>
