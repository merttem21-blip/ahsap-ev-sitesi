---
// Ana sayfa hero'su: hero'yu tamamen kaplayan proje fotoğrafı, üstünde karartma, solda metin,
// altta ikon şeridi. Metin (h1, açıklama, butonlar) slot'tan gelir.
//
// Fotoğraf <picture> ile seçilir: ≤ 640px'te ana yapıya kırpılmış dikey kesim, ≤ 1023px'te 960px'lik
// sürüm, üstünde tam boyut. Dosyalar public/images/hero/ içindedir.
//
// Hareket (marka-stili §6): fotoğrafta çok yavaş yakınlaşma, metin sırayla belirir.
// prefers-reduced-motion açıkken ikisi de olmaz. Parallax için .hero-sahne'ye data-parallax verilir
// (src/scripts/hareket.ts).
import { ikon } from '../data/ikonlar';

interface Props {
  gorsel: {
    /** ≤ 640px: dikey kesim */
    mobil: string;
    /** 641–1023px */
    tablet: string;
    /** ≥ 1024px ve yedek; width/height bu dosyanındır */
    masaustu: string;
    width: number;
    height: number;
    alt: string;
  };
}

const { gorsel } = Astro.props;

const serit = [
  { ad: 'Doğal Malzeme', ikon: ikon.yaprak },
  { ad: 'Modern Tasarım', ikon: ikon.ev },
  { ad: 'Güvenilir Uygulama', ikon: ikon.kalkan },
];
---

<section class="hero" aria-labelledby="hero-baslik">
  <div class="hero-sahne" data-parallax>
    <picture>
      <source media="(max-width: 640px)" srcset={gorsel.mobil} type="image/webp" />
      <source media="(max-width: 1023px)" srcset={gorsel.tablet} type="image/webp" />
      <img
        src={gorsel.masaustu}
        alt={gorsel.alt}
        width={gorsel.width}
        height={gorsel.height}
        fetchpriority="high"
        decoding="async"
        loading="eager"
      />
    </picture>
  </div>

  <div class="kap hero-ic">
    <div class="hero-metin">
      <slot />
    </div>

    <ul class="hero-serit">
      {
        serit.map((s) => (
          <li>
            <svg class="ikon" viewBox="0 0 24 24" aria-hidden="true" set:html={s.ikon} />
            <span class="etiket">{s.ad}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .hero {
    --h-ust: 122px; /* ana sayfa header'ı: 90px logo + 2 × 16px (Header.astro) */
    --karartma-ton: 20 18 16; /* fotoğraf karartmasının rengi (rgb kanalları) */
    position: relative;
    display: flex;
    min-height: 100vh;
    min-height: 100svh;
    padding-top: var(--h-ust);
    overflow: hidden;
    isolation: isolate; /* katmanlar (fotoğraf 0, karartma 1, metin 2) hero'nun dışına karışmaz */
    background: var(--color-zemin);
    color: var(--color-krem);
  }

  /* Fotoğraf katmanı: hero'yu boşluksuz kaplar. Parallax bu katmana uygulanır. */
  .hero-sahne {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero-sahne img {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
    transform-origin: center 40%;
  }

  /* Karartma: mobilde metin alt yarıda ve tam genişlikte; aşağı doğru koyulaşır */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      180deg,
      rgb(var(--karartma-ton) / 0.55) 0%,
      rgb(var(--karartma-ton) / 0.7) 45%,
      rgb(var(--karartma-ton) / 0.85) 100%
    );
    pointer-events: none;
  }

  .hero-ic {
    position: relative;
    z-index: 2;
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: flex-end;
    gap: var(--bosluk-5);
    padding-top: 34svh;
    padding-bottom: var(--bosluk-5);
  }

  .hero-metin {
    max-width: 36rem;
  }

  .hero-metin :global(h1) {
    font-size: clamp(2.25rem, 3.8vw, 3.75rem);
    line-height: 1.05;
    text-shadow: 0 2px 20px rgb(0 0 0 / 0.35);
  }

  .hero-metin :global(p) {
    max-width: 48ch;
    margin: var(--bosluk-3) 0 var(--bosluk-4);
    color: var(--color-krem);
    font-size: var(--text-giris);
  }

  .hero-metin :global(.hero-dugmeler) {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  /* İkon şeridi: ince dikey çizgilerle ayrılmış üç sütun */
  .hero-serit {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: var(--cizgi) solid var(--color-cizgi);
  }

  .hero-serit li {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    padding: var(--bosluk-3) 12px 0;
  }

  .hero-serit li:first-child {
    padding-left: 0;
  }

  .hero-serit li + li {
    border-left: var(--cizgi) solid var(--color-cizgi);
  }

  .hero-serit .ikon {
    width: 28px;
    height: 28px;
    color: var(--color-ahsap);
    stroke-width: 1.25;
  }

  .hero-serit .etiket {
    color: var(--color-krem);
  }

  /* Giriş ve yakınlaşma yalnızca hareket azaltılmamışsa; JS gerekmez, animasyon bitince içerik görünür */
  @media (prefers-reduced-motion: no-preference) {
    .hero-sahne img {
      animation: hero-yakinlas var(--sure-kenburns) linear forwards;
    }

    .hero-metin :global(h1),
    .hero-metin :global(p),
    .hero-metin :global(.hero-dugmeler),
    .hero-serit li {
      animation: hero-ortaya var(--sure-ortaya) var(--ease-ortaya) both;
    }

    .hero-metin :global(h1) {
      animation-delay: 150ms;
    }

    .hero-metin :global(p) {
      animation-delay: 300ms;
    }

    .hero-metin :global(.hero-dugmeler) {
      animation-delay: 450ms;
    }

    .hero-serit li:nth-child(1) {
      animation-delay: 600ms;
    }

    .hero-serit li:nth-child(2) {
      animation-delay: 680ms;
    }

    .hero-serit li:nth-child(3) {
      animation-delay: 760ms;
    }
  }

  @keyframes hero-yakinlas {
    from {
      transform: scale(1);
    }
    to {
      transform: scale(1.06);
    }
  }

  @keyframes hero-ortaya {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
  }

  /* ≥ 640px: şerit öğeleri ikon + etiket yan yana */
  @media (min-width: 640px) {
    .hero-serit li {
      flex-direction: row;
      align-items: center;
      gap: 14px;
      padding-inline: var(--bosluk-3);
    }
  }

  /* ≥ 641px: tablet ve masaüstü fotoğrafı (<picture> kaynaklarıyla aynı sınır).
     Karartma soldaki metin bölgesinde en koyu, sağa doğru açılır; alttaki katman ikon şeridini okutur. */
  @media (min-width: 641px) {
    .hero-sahne img {
      object-position: center center;
      transform-origin: center center;
    }

    .hero::before {
      background:
        linear-gradient(0deg, rgb(var(--karartma-ton) / 0.55) 0%, transparent 35%),
        linear-gradient(
          90deg,
          rgb(var(--karartma-ton) / 0.85) 0%,
          rgb(var(--karartma-ton) / 0.65) 35%,
          rgb(var(--karartma-ton) / 0.25) 65%,
          rgb(var(--karartma-ton) / 0.1) 100%
        );
    }
  }

  /* ≥ 1024px: metin solda dikeyde ortalı, ikon şeridi altta */
  @media (min-width: 1024px) {
    .hero {
      --h-ust: 188px; /* 140px logo + 2 × 24px */
    }

    .hero-ic {
      justify-content: space-between;
      padding-top: 0;
    }

    .hero-metin {
      margin-block: auto;
      max-width: min(32rem, calc(42vw - 80px));
    }
  }
</style>
