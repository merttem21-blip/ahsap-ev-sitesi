---
// Ana sayfa hero'su: hero'yu tamamen kaplayan proje fotoğrafı, üstünde karartma, solda metin,
// altta ikon şeridi. Metin (h1, açıklama, butonlar) slot'tan gelir.
//
// Fotoğraf <picture> ile seçilir: ≤ 640px'te ana yapıya kırpılmış dikey kesim, ≤ 1023px'te 960px'lik
// sürüm, üstünde tam boyut. Dosyalar public/images/hero/ içindedir.
//
// Mobilde dikey kesim kendi oranında hero'nun üstünde durur (yapı yandan kırpılmaz). Metin ilk ekranın altına,
// mobil alt menünün (ilk ziyarette çerez bandının) üstüne yaslanır; ikon şeridi alt menünün altında, ilk ekranın
// dışında kalır.
// ≥ 641px'te fotoğraf hero'yu kaplar; dikey tablette ve uzun ekranda hero'nun boyu sınırlıdır.
// İki düzende de fotoğrafın alt kenarı sayfa zeminine erir (--zemine-eris); sonraki bölüm aynı zeminden
// başladığı için hero ile arasında çizgi oluşmaz.
//
// Hareket (marka-stili §6): fotoğrafta çok yavaş yakınlaşma, metin sırayla belirir.
// prefers-reduced-motion açıkken ikisi de olmaz. Parallax için .hero-sahne'ye data-parallax verilir
// (src/scripts/hareket.ts).
import { ikon } from '../data/ikonlar';

interface Props {
  gorsel: {
    /** ≤ 640px: dikey kesim */
    mobil: string;
    /** Dikey kesimin boyutu: mobilde fotoğraf katmanı bu oranda olur */
    mobilWidth: number;
    mobilHeight: number;
    /** 641–1023px */
    tablet: string;
    /** ≥ 1024px ve yedek; width/height bu dosyanındır */
    masaustu: string;
    width: number;
    height: number;
    alt: string;
  };
}

const { gorsel } = Astro.props;

const serit = [
  { ad: 'Doğal Malzeme', ikon: ikon.yaprak },
  { ad: 'Modern Tasarım', ikon: ikon.ev },
  { ad: 'Güvenilir Uygulama', ikon: ikon.kalkan },
];
---

<section
  class="hero"
  aria-labelledby="hero-baslik"
  style={`--mobil-w: ${gorsel.mobilWidth}; --mobil-h: ${gorsel.mobilHeight}`}
>
  <div class="hero-sahne" data-parallax>
    <picture>
      <source media="(max-width: 640px)" srcset={gorsel.mobil} type="image/webp" />
      <source media="(max-width: 1023px)" srcset={gorsel.tablet} type="image/webp" />
      <img
        src={gorsel.masaustu}
        alt={gorsel.alt}
        width={gorsel.width}
        height={gorsel.height}
        fetchpriority="high"
        decoding="async"
        loading="eager"
      />
    </picture>
  </div>

  <div class="kap hero-ic">
    <div class="hero-metin">
      <slot />
    </div>

    <ul class="hero-serit">
      {
        serit.map((s) => (
          <li>
            <svg class="ikon" viewBox="0 0 24 24" aria-hidden="true" set:html={s.ikon} />
            <span class="etiket">{s.ad}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  /* --ekran: sayfa açıldığındaki görünür ekran boyu. svh, tarayıcının adres ve araç çubukları görünürkenki boydur;
     dvh kullanılmaz: çubuklar kaydırınca gizlendiğinde hero'nun boyu değişir, sayfa zıplar. */
  .hero {
    --h-ust: 122px; /* ana sayfa header'ı: 90px logo + 2 × 16px (Header.astro) */
    --ekran: 100vh;
    position: relative;
    display: flex;
    padding-top: var(--h-ust);
    overflow: hidden;
    isolation: isolate; /* katmanlar (fotoğraf 0, karartma 1, metin 2) hero'nun dışına karışmaz */
    background: var(--color-zemin);
    color: var(--color-krem);
  }

  @supports (height: 100svh) {
    .hero {
      --ekran: 100svh;
    }
  }

  /* Fotoğraf katmanı. Parallax bu katmana uygulanır.
     Mobil: dikey kesim kendi oranında, tam genişlikte ve hero'nun üstünde; cover hiçbir yanı kırpmaz.
     Alt %45'i sayfa zeminine erir; hero'nun geri kalanı zaten zemin rengindedir. */
  .hero-sahne {
    position: absolute;
    inset: 0 0 auto;
    z-index: 0;
    aspect-ratio: var(--mobil-w) / var(--mobil-h);
    overflow: hidden; /* yakınlaşan fotoğraf erimenin altından taşmaz */
  }

  .hero-sahne img {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    transform-origin: center 40%; /* yakınlaşmada çatının tepesi kadrajda kalır */
  }

  .hero-sahne::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: var(--zemine-eris) bottom / 100% 45% no-repeat;
    pointer-events: none;
  }

  /* Mobil: ilk ekran, mobil alt menünün (ve iPhone'un alt güvenli alanının) üstünde kalan görünür alandır.
     Metin bloğu (başlık, açıklama, düğmeler) bu alanın altına --metin-pay kadar boşlukla yaslanır; ikon şeridi
     ilk ekranın altından devam eder. Metin alana sığmayacak kadar kısa ekranda header'ın hemen altından başlar. */
  .hero-ic {
    --metin-pay: var(--bosluk-3);
    position: relative;
    z-index: 2;
    display: grid;
    flex: 1;
    grid-template-rows:
      minmax(calc(var(--ekran) - var(--alt-menu-alan) - var(--h-ust) - var(--metin-pay)), auto)
      auto;
    gap: var(--bosluk-5);
    padding-bottom: var(--bosluk-5);
  }

  /* Çerez bandı açıkken (ilk ziyaret) metin bloğu bandın üstüne çıkar: --cerez-alan bandın kapladığı alt alandır
     (CerezBandi.astro), alt menünün payı zaten --alt-menu-alan'dadır. Satırın boyu değişmez, ikon şeridi yerinde kalır.
     Metnin yükselemeyeceği kadar kısa ekranda header'ın altından başlar ve bant düğmeleri yine örtebilir. */
  .hero-metin {
    position: relative;
    align-self: end;
    max-width: 36rem;
    margin-bottom: max(0px, calc(var(--cerez-alan, 0px) - var(--alt-menu-alan)));
  }

  /* Mobil karartma metin bloğuna bağlıdır: metin uzasa da fotoğraf kaysa da altında kalır.
     Metnin üstünde --rampa boyunca açılır; metnin başladığı yerden aşağısı %70 gece (marka-stili §2).
     Yanlara ve aşağı taşar, hero'nun overflow'u keser. Zemin üstünde görünmez (gece = zemin). */
  .hero-metin::before {
    --rampa: 64px;
    content: '';
    position: absolute;
    inset: calc(var(--rampa) * -1) -100vw -100vh;
    z-index: -1;
    background: linear-gradient(180deg, transparent, var(--color-karartma) var(--rampa));
    pointer-events: none;
  }

  .hero-metin :global(h1) {
    font-size: clamp(2.25rem, 3.8vw, 3.75rem);
    line-height: 1.05;
    text-shadow: 0 2px 20px rgb(0 0 0 / 0.35);
  }

  /* Mobilde açıklamanın üst ve alt boşluğu kısa ekranda bir adım (8px) daralır: 560 px boyda 16 / 24px, 640 px ve
     üstünde 24 / 32px. Böylece iPhone SE'de bile (Safari'de ~553 px görünür alan) metin bloğu header ile alt menünün
     arasına sığar. Yazı boyutları değişmez. */
  .hero-metin :global(p) {
    max-width: 48ch;
    margin: clamp(var(--bosluk-2), calc(var(--ekran) / 10 - 40px), var(--bosluk-3)) 0
      clamp(var(--bosluk-3), calc(var(--ekran) / 10 - 32px), var(--bosluk-4));
    color: var(--color-krem);
    font-size: var(--text-giris);
  }

  .hero-metin :global(.hero-dugmeler) {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  /* İkon şeridi: ince dikey çizgilerle ayrılmış üç sütun */
  .hero-serit {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: var(--cizgi) solid var(--color-cizgi);
  }

  .hero-serit li {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    padding: var(--bosluk-3) 12px 0;
  }

  .hero-serit li:first-child {
    padding-left: 0;
  }

  .hero-serit li + li {
    border-left: var(--cizgi) solid var(--color-cizgi);
  }

  .hero-serit .ikon {
    width: 28px;
    height: 28px;
    color: var(--color-ahsap);
    stroke-width: 1.25;
  }

  .hero-serit .etiket {
    color: var(--color-krem);
  }

  /* Giriş ve yakınlaşma yalnızca hareket azaltılmamışsa; JS gerekmez, animasyon bitince içerik görünür */
  @media (prefers-reduced-motion: no-preference) {
    .hero-sahne img {
      animation: hero-yakinlas var(--sure-kenburns) linear forwards;
    }

    .hero-metin :global(h1),
    .hero-metin :global(p),
    .hero-metin :global(.hero-dugmeler),
    .hero-serit li {
      animation: hero-ortaya var(--sure-ortaya) var(--ease-ortaya) both;
    }

    .hero-metin :global(h1) {
      animation-delay: 150ms;
    }

    .hero-metin :global(p) {
      animation-delay: 300ms;
    }

    .hero-metin :global(.hero-dugmeler) {
      animation-delay: 450ms;
    }

    .hero-serit li:nth-child(1) {
      animation-delay: 600ms;
    }

    .hero-serit li:nth-child(2) {
      animation-delay: 680ms;
    }

    .hero-serit li:nth-child(3) {
      animation-delay: 760ms;
    }
  }

  @keyframes hero-yakinlas {
    from {
      transform: scale(1);
    }
    to {
      transform: scale(1.06);
    }
  }

  @keyframes hero-ortaya {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
  }

  /* ≥ 640px: şerit öğeleri ikon + etiket yan yana */
  @media (min-width: 640px) {
    .hero-serit li {
      flex-direction: row;
      align-items: center;
      gap: 14px;
      padding-inline: var(--bosluk-3);
    }
  }

  /* ≥ 641px: tablet ve masaüstü fotoğrafı (<picture> kaynaklarıyla aynı sınır); fotoğraf hero'yu kaplar.
     Karartma soldaki metin bölgesinde en koyu, sağa doğru açılır. Alt %30 sayfa zeminine erir ve ikon şeridini
     okutur; erime hero'ya bağlıdır, parallax'ta fotoğraf altından kayar ve kenar görünmez.
     Hero ekran boyundadır, ama en fazla genişliğin %90'ı kadar: dikey tablette ve uzun ekranda (ör. telefonda
     "masaüstü sitesi") fotoğraf ekran boyunca uzayıp yalnızca ortasını göstermez, fotoğrafın en az ~%60'ı
     görünür. Yatay ekranda sınır devreye girmez. Metin header ile ikon şeridinin arasında dikeyde ortalıdır. */
  @media (min-width: 641px) {
    .hero {
      min-height: min(var(--ekran), 90vw);
    }

    .hero-ic {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .hero-metin {
      align-self: auto;
      margin-block: auto;
    }

    .hero-metin :global(p) {
      margin: var(--bosluk-3) 0 var(--bosluk-4);
    }

    .hero-sahne {
      inset: 0;
      aspect-ratio: auto;
    }

    .hero-sahne img {
      object-position: center center;
      transform-origin: center center;
    }

    .hero-sahne::after,
    .hero-metin::before {
      content: none;
    }

    .hero::before {
      content: '';
      position: absolute;
      inset: 0;
      z-index: 1;
      background:
        var(--zemine-eris) bottom / 100% 30% no-repeat,
        var(--karartma-yatay);
      pointer-events: none;
    }
  }

  /* ≥ 1024px: metin sütunu fotoğrafın %42'sinden önce biter */
  @media (min-width: 1024px) {
    .hero {
      --h-ust: 188px; /* 140px logo + 2 × 24px */
    }

    .hero-metin {
      max-width: min(32rem, calc(42vw - 80px));
    }
  }

  /* ≥ 1280px: masaüstünde hero her zaman ekran boyundadır (onaylı görünüm; boy sınırı yok) */
  @media (min-width: 1280px) {
    .hero {
      min-height: var(--ekran);
    }
  }
</style>
