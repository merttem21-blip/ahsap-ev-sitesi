---
// Mobil alt menü (< 768px): ekranın altında, kenarlardan 12px içeride havada duran düz antrasit bar.
// Projeler · Galeri · Teklif Al (ortada, barın üstüne taşan yuvarlak) · WhatsApp · Menü.
// "Menü" tam ekran menü panelini açar; aç/kapa, Esc ve dışarı tıklama Header.astro'daki script'tedir.
// Teklif Al ve WhatsApp linkleri sayfaya göre gelir (Layout: teklifAdresi, whatsappMesaj).
// Gradyan, gölge ve backdrop-filter yok; hareket yalnızca basınca küçülme (scale).
import { siWhatsapp } from 'simple-icons';
import { menuAktifMi, whatsappLinki } from '../data/site';
import { ikon } from '../data/ikonlar';

interface Props {
  teklifAdresi?: string;
  whatsappMesaj?: string;
}

const { teklifAdresi = '/teklif-al', whatsappMesaj } = Astro.props;
const yol = Astro.url.pathname.replace(/\/$/, '') || '/';
const aktif = (href: string) => (menuAktifMi(yol, href) ? 'page' : undefined);
---

<nav class="alt-menu" aria-label="Hızlı erişim">
  <ul>
    <li>
      <a href="/projeler" class="am-oge" aria-current={aktif('/projeler')}>
        <span class="am-ikon"><svg class="ikon" viewBox="0 0 24 24" aria-hidden="true" set:html={ikon.izgara} /></span>
        <span class="am-etiket">Projeler</span>
      </a>
    </li>
    <li>
      <a href="/galeri" class="am-oge" aria-current={aktif('/galeri')}>
        <span class="am-ikon"><svg class="ikon" viewBox="0 0 24 24" aria-hidden="true" set:html={ikon.galeri} /></span>
        <span class="am-etiket">Galeri</span>
      </a>
    </li>
    <li>
      <a href={teklifAdresi} class="am-oge am-teklif" aria-current={aktif('/teklif-al')}>
        <span class="am-daire"><svg class="ikon" viewBox="0 0 24 24" aria-hidden="true" set:html={ikon.teklif} /></span>
        <span class="am-etiket">Teklif Al</span>
      </a>
    </li>
    <li>
      <a href={whatsappLinki(whatsappMesaj)} class="am-oge am-wa" target="_blank" rel="noopener noreferrer">
        <span class="am-ikon"><svg class="ikon" viewBox="0 0 24 24" aria-hidden="true"><path d={siWhatsapp.path} /></svg></span>
        <span class="am-etiket">WhatsApp</span>
      </a>
    </li>
    <li>
      <button type="button" class="am-oge" aria-controls="ana-menu" aria-expanded="false" data-menu-dugme>
        <span class="am-ikon">
          <svg class="ikon ikon-menu" viewBox="0 0 24 24" aria-hidden="true" set:html={ikon.menu} />
          <svg class="ikon ikon-kapat" viewBox="0 0 24 24" aria-hidden="true" set:html={ikon.kapat} />
        </span>
        <span class="am-etiket">Menü</span>
      </button>
    </li>
  </ul>
</nav>

<style>
  .alt-menu {
    position: fixed;
    right: var(--alt-menu-pay);
    bottom: calc(var(--alt-menu-pay) + env(safe-area-inset-bottom, 0px));
    left: var(--alt-menu-pay);
    z-index: var(--z-alt-menu);
    height: var(--alt-menu-h);
    border: var(--cizgi) solid var(--color-cizgi-menu);
    border-radius: var(--radius-alt-menu);
    background: var(--color-antrasit);
  }

  .alt-menu ul {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    height: 100%;
  }

  /* Dokunma alanı: hücrenin tamamı (≥ 58 × 62px). Etiketler alttan aynı hizada durur. */
  .am-oge {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    gap: 3px;
    width: 100%;
    height: 100%;
    min-height: 48px;
    padding: 0 0 7px;
    border: 0;
    border-radius: var(--radius-kart);
    background: none;
    color: var(--color-metin-soluk);
    font: inherit;
    text-decoration: none;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition: scale var(--gecis);
  }

  .am-oge:active {
    scale: 0.96;
  }

  /* Odak halkası hücrenin içinde kalır; bar kenarının dışına taşmaz */
  .am-oge:focus-visible {
    outline-offset: -2px;
  }

  .am-ikon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 28px;
    border-radius: var(--radius-tam);
  }

  .am-ikon .ikon {
    width: 22px;
    height: 22px;
  }

  .am-etiket {
    font-size: clamp(0.6875rem, 3.2vw, 0.75rem);
    font-weight: 500;
    line-height: 1.2;
    white-space: nowrap;
  }

  /* Aktif sayfa ve açık menü: ikon arkasında krem %10 düz pill, krem etiket */
  .am-oge:is([aria-current='page'], [aria-expanded='true']) {
    color: var(--color-krem);
  }

  .am-oge:is([aria-current='page'], [aria-expanded='true']) .am-ikon {
    background: var(--color-yuzey-aktif);
  }

  @media (hover: hover) {
    .am-oge:hover {
      color: var(--color-krem);
    }
  }

  /* WhatsApp: resmi logo, yeşil (simple-icons dolgulu; genel .ikon çizgi stili geçersiz) */
  .am-wa .ikon {
    color: var(--color-whatsapp);
    fill: currentColor;
    stroke: none;
  }

  .ikon-kapat,
  [aria-expanded='true'] .ikon-menu {
    display: none;
  }

  [aria-expanded='true'] .ikon-kapat {
    display: block;
  }

  /* Teklif Al: barın 16px üstüne taşan 58px krem daire, antrasit ikon ve 4px antrasit çerçeve.
     Çerçeve barın üst çizgisini daire çevresinde keser; etiket diğerleriyle aynı hizada kalır. */
  .am-teklif {
    justify-content: flex-start;
    gap: 0;
  }

  .am-daire {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 58px;
    height: 58px;
    margin-top: calc(-16px - var(--cizgi));
    border: 4px solid var(--color-antrasit);
    border-radius: 50%;
    background: var(--color-krem);
    color: var(--color-antrasit);
  }

  .am-daire .ikon {
    width: 24px;
    height: 24px;
  }

  /* Odak halkası dairenin çevresinde */
  .am-teklif:focus-visible {
    outline: none;
  }

  .am-teklif:focus-visible .am-daire {
    outline: 2px solid var(--color-krem);
    outline-offset: 2px;
  }

  /* Işık kutusu açıkken ve formda yazarken (ekran klavyesi) bar gizlenir */
  :global(html.kaydirma-kilitli) .alt-menu,
  :global(body:has(:is(input:not([type='checkbox'], [type='radio']), textarea, select):focus)) .alt-menu {
    display: none;
  }

  /* ≥ 768px: masaüstü/tablet header menüsü kullanılır */
  @media (min-width: 768px) {
    .alt-menu {
      display: none;
    }
  }

  @media print {
    .alt-menu {
      display: none;
    }
  }
</style>
