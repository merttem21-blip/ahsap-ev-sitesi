---
// Etiketli metin girdisi veya metin alanı: etiket → yardım metni → girdi → hata (aria-describedby ile bağlı).
// Hata metnini src/scripts/form.ts yazar. Sayfada tek form olduğu için id'ler alan adından üretilir.
// sayac: metin alanının altında kalan karakter sayısı (yalnızca JS açıkken görünür; sayıyı form.ts günceller).
interface Props {
  ad: string;
  etiket: string;
  tip?: 'text' | 'tel' | 'email' | 'textarea';
  zorunlu?: boolean;
  yardim?: string;
  ornek?: string; // placeholder: yalnızca biçim örneği, etiketin yerine geçmez
  autocomplete?: string;
  inputmode?: 'text' | 'tel' | 'email' | 'numeric' | 'decimal';
  maxlength: number;
  sayac?: boolean;
}

const {
  ad,
  etiket,
  tip = 'text',
  zorunlu = false,
  yardim,
  ornek,
  autocomplete = 'off',
  inputmode,
  maxlength,
  sayac = false,
} = Astro.props;
const id = `alan-${ad}`;
const aciklama = [yardim && `yardim-${ad}`, sayac && `sayac-${ad}`, `hata-${ad}`].filter(Boolean).join(' ');
---

<div class="alan" data-alan={ad}>
  <label class="alan-etiket" for={id}>
    {etiket}{!zorunlu && <span class="alan-istege"> (isteğe bağlı)</span>}
  </label>
  {yardim && <p class="alan-yardim" id={`yardim-${ad}`}>{yardim}</p>}
  {
    tip === 'textarea' ? (
      <textarea
        class="girdi girdi-uzun"
        id={id}
        name={ad}
        rows="5"
        maxlength={maxlength}
        placeholder={ornek}
        required={zorunlu}
        aria-describedby={aciklama}
      />
    ) : (
      <input
        class="girdi"
        id={id}
        name={ad}
        type={tip}
        maxlength={maxlength}
        placeholder={ornek}
        autocomplete={autocomplete}
        inputmode={inputmode}
        required={zorunlu}
        aria-describedby={aciklama}
      />
    )
  }
  {
    sayac && (
      <>
        <p class="alan-sayac" id={`sayac-${ad}`} data-sayac data-js hidden>
          {maxlength} karakter kaldı
        </p>
        <span class="gizli" role="status" data-sayac-canli />
      </>
    )
  }
  <p class="alan-hata" id={`hata-${ad}`} data-hata></p>
</div>
