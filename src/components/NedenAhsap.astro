---
// Neden 2K Ahşap: firmanın çalışma biçimi, 6 maddelik ikonlu ızgara. Ana sayfada ve Hakkımızda'da kullanılır.
// Mobilde tek sütun, ≥ 640px'te 2 × 3, ≥ 1024px'te 3 × 2.
// Metinde süre, fiyat, garanti gibi kesin rakam ve taahhüt yazılmaz (CLAUDE.md metin kuralı).
import { ikon } from '../data/ikonlar';

const maddeler = [
  {
    ikon: ikon.cekic,
    baslik: 'Kendi Atölyemizde Üretim',
    metin: 'Yapılarımızı kendi atölyemizde, her aşamasını kontrol ederek üretiyoruz.',
  },
  {
    ikon: ikon.ekip,
    baslik: 'Kendi Kurulum Ekibimiz',
    metin: 'Kurulumu, üretimi de yakından bilen kendi ekibimiz yapıyor.',
  },
  {
    ikon: ikon.kalemCetvel,
    baslik: 'Size Özel Tasarım',
    metin: 'Her projeyi arazinize, ihtiyacınıza ve zevkinize göre tasarlıyoruz.',
  },
  {
    ikon: ikon.kalkan,
    baslik: 'Teslim Sonrası Destek',
    metin: 'Yapınızı teslim ettikten sonra da bakım ve destek için yanınızdayız.',
  },
  {
    ikon: ikon.konum,
    baslik: 'Türkiye Geneli Hizmet',
    metin: 'Farklı illerdeki projelerinizi yerinde hayata geçiriyoruz.',
  },
  {
    ikon: ikon.rota,
    baslik: 'Tek Muhatap, Uçtan Uca Süreç',
    metin: 'Tasarımdan teslime kadar tüm süreci tek ekip yönetir; sorumluluk tek elde toplanır.',
  },
];
---

<section class="neden" aria-labelledby="neden-baslik">
  <div class="kap">
    <header class="neden-ust" data-ortaya>
      <h2 id="neden-baslik">Neden 2K Ahşap?</h2>
      <p>
        2015'ten bu yana, doğal ahşabı modern mimariyle buluşturan yapıları tasarlıyor, üretiyor ve
        kuruyoruz.
      </p>
    </header>

    <ul class="neden-izgara">
      {
        maddeler.map((m) => (
          <li class="neden-madde" data-ortaya>
            <span class="neden-ikon" aria-hidden="true">
              <svg class="ikon" viewBox="0 0 24 24" set:html={m.ikon} />
            </span>
            <h3>{m.baslik}</h3>
            <p>{m.metin}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  /* Ana sayfanın bölüm ritmi (--bolum-ritim, index.astro) varsa onu kullanır. Ara yumuşak ton; çevresindeki gece
     bölümlerden yalnızca ton farkıyla ayrılır, sınırda çizgi yok. */
  .neden {
    padding-block: var(--bolum-ritim, var(--bolum));
    background: var(--color-zemin-ara-yumusak);
  }

  .neden-ust {
    margin-bottom: var(--bosluk-5);
  }

  .neden-ust h2 {
    font-size: var(--text-h2);
  }

  .neden-ust > p {
    max-width: 48ch;
    margin: var(--bosluk-2) 0 0;
  }

  .neden-izgara {
    display: grid;
    gap: var(--bosluk-2);
  }

  /* Kart: yüzey zemini, ince çizgi kenar, 16px köşe; gölge yok. Tıklanabilir değil: hover'da kart değil,
     yalnızca ikon tepki verir (aşağıda). */
  .neden-madde {
    padding: var(--bosluk-4) var(--bosluk-3);
    background: var(--color-yuzey);
    border: var(--cizgi) solid var(--color-cizgi);
    border-radius: var(--radius-kart);
  }

  .neden-ikon {
    position: relative;
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    margin-bottom: var(--bosluk-3);
    border: var(--cizgi) solid var(--color-cizgi);
    border-radius: var(--radius-tam);
    color: var(--color-ahsap);
    transition: transform var(--gecis);
  }

  /* Hover katmanı: butonlardaki gibi ahşap çerçeve, yalnızca opacity ile belirir */
  .neden-ikon::before {
    content: '';
    position: absolute;
    inset: calc(var(--cizgi) * -1);
    border: var(--cizgi) solid var(--color-ahsap);
    border-radius: inherit;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--gecis);
  }

  .neden-ikon .ikon {
    width: 26px;
    height: 26px;
  }

  /* Kartın üzerine gelince ikonun çerçevesi ahşaba döner ve ikon 3px kalkar. Dokunmatik ekranda (hover: none)
     yok; hareket azaltılmışsa yalnızca çerçeve rengi değişir. Kartta odaklanabilir öğe olursa klavyede de çalışır. */
  .neden-madde:focus-within .neden-ikon::before {
    opacity: 1;
  }

  @media (hover: hover) {
    .neden-madde:hover .neden-ikon::before {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .neden-madde:focus-within .neden-ikon {
      transform: translateY(-3px);
    }
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .neden-madde:hover .neden-ikon {
      transform: translateY(-3px);
    }
  }

  .neden-madde h3 {
    font-size: var(--text-h3);
  }

  .neden-madde p {
    margin: var(--bosluk-1) 0 0;
  }

  /* ≥ 640px: 2 × 3 */
  @media (min-width: 640px) {
    .neden-izgara {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--bosluk-3);
    }
  }

  /* ≥ 1024px: 3 × 2; başlık solda, açıklama sağda */
  @media (min-width: 1024px) {
    .neden-ust {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 24rem);
      align-items: end;
      gap: var(--bosluk-5);
      margin-bottom: var(--bosluk-6);
    }

    .neden-ust > p {
      margin: 0;
    }

    .neden-izgara {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .neden-madde {
      padding: var(--bosluk-5) var(--bosluk-4);
    }
  }
</style>
